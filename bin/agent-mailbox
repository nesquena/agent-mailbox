#!/bin/sh
# agent-mailbox: a small, file-based mailbox for AI agents (and the humans who run them).
# Spec: PROTOCOL.md. Guide for a joining agent: JOIN.md. POSIX sh; needs git for the git adapter, and OpenSSH 8.1+
# (ssh-keygen -Y) only for signed mail.
#
# Usage: agent-mailbox [--as <name>] [--config <file>] <command> [args]
#
#   setup --store <url|path> [--adapter git|dir] [--root <dir>] [--branch <b>] [--name <me>] [--human <h>]
#                                       write this machine's config (see "Configuration" in README.md)
#   init [--require-signatures] [--title <text>]
#                                       create the mailbox layout in an empty store (once per store)
#   register --kind <kind> --about <text> [--runs-on <text>] [--watch <text>] [--key <pub>|--no-key]
#            [--human <h>] [--env <e>] [--groups "<g> ..."]
#                                       add yourself to the registry; generates a signing key unless --no-key
#   update [--kind ...] [--about ...] [--runs-on ...] [--watch ...] [--human ...] [--env ...] [--groups ...]
#          [--status active|retired [--force]]
#                                       change your own registry record (an empty --human, --env or --groups
#                                       clears it)
#   agents [--human <h>] [--env <e>] [--group <g>]... [--names]
#                                       list registered agents, those matching every filter given; --names prints
#                                       only the names of the active ones, one per line (human, env and groups are
#                                       each agent's own claims, which nothing checks)
#   trust <name>                        accept <name>'s current key after it changed (re-pins it)
#   trust --relax                       stop treating this store as strict after its store.md stopped requiring
#                                       signatures (a store seen strict stays strict for you until then)
#   send <to> <topic> <body.md|-> [--context <c>] [--in-reply-to <file>] [--needs <text>] [--consume <file>]...
#        [--hold|--release "<item> <version>"]
#                                       deliver a message; --consume also removes mail you're answering
#   reply <file> <body.md|-> [--needs <text>] [--context <c>] [--hold|--release "<item> <version>"] [--keep]
#                                       answer a message in your inbox: send to its sender, on its topic and context,
#                                       and consume it in the same change (--keep: leave it in your inbox)
#   list                                your inbox, oldest first (exit 0: some, 3: none)
#   sent [<to>]                         your mail still waiting in recipients' inboxes (not yet consumed), oldest first,
#                                       with its age and needs, and stale past 24 h (exit 0 / 3); it goes by file
#                                       names and from: headers, not signatures
#   read [--except <file>]...           every message in full, with its signature status (exit 0 / 3)
#   consume [--] <file>...              remove messages you've acted on (the read receipt)
#   verify <file>                       check one message's signature, and its routing when it sits in an inbox;
#                                       a bare file name is looked up in your inbox (exit 0: verified, 6: not)
#   holds [<item>] [--version <v>]      each sender's latest hold or release in mail to you; with an item and
#                                       --version, exit 0 only if every sender's latest record releases it (else 5)
#   watch [interval=120] [max=7000] [--except <file>]... [--also]
#                                       wait for mail without spending model tokens; exits 0 with the mail listed,
#                                       2 after max seconds (0 = no limit). Run it in the background. --also: in a
#                                       Claude Code session, the plugin's hook watches this store too, not instead
#   whoami | doctor                     show the resolved config | check this machine's setup
#   --version                           the CLI's version and protocol, and its commit when run from a git clone
#
# Exit codes: 0 ok; 1 usage or store error; 2 watch timed out; 3 no mail; 4 a change saved locally isn't published
# (re-run a command with the same name to publish; don't resend, unless it says this command wrote nothing: then run it
# again once that's published); 5 not released; 6 signature not verified.
set -u
VERSION=0.1.2
# (set only by init, around its own commit: never taken from the environment)
AD_INIT=
PROTOCOL=1
NS=agent-mailbox
# (set only by the git adapter, around its push of what an earlier command left, and around its sync's rebase of it:
# never taken from the environment)
AD_LEFTOVER= AD_UNSTICK=
# (adapter state the CLI reads, set only by the adapter: never taken from the environment. AD_PUBLISHED: this
# command's sync published what an earlier one left; AD_UNCHANGED: its last commit wrote nothing new; AD_HISTORY, set
# when it's sourced: full when ad_history lists every version, anything else (or unset) when it may not)
AD_DIR= AD_PUBLISHED= AD_UNCHANGED= AD_HISTORY=
NAME_RE='^[a-z0-9][a-z0-9.-]{0,62}$'
# a record's groups: up to 16 names, one space between each (PROTOCOL.md section 4)
GROUPS_RE='^[a-z0-9][a-z0-9.-]{0,62}( [a-z0-9][a-z0-9.-]{0,62}){0,15}$'
ITEM_RE='^[A-Za-z0-9._/#:@-]{1,200} [A-Za-z0-9._-]{1,64}$'
# a message file name (PROTOCOL.md section 5); any other file in an inbox isn't a message, and is ignored
MSG_RE='^[A-Za-z0-9._-]+\.md$'
# a message's sent time, as send writes it
SENT_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
# a registry key: "<type> <base64>" and nothing else, so no allowed_signers option can reach ssh-keygen
KEY_RE='^(ssh-[a-z0-9-]+|ecdsa-[a-z0-9-]+|sk-[a-z0-9@.-]+) [A-Za-z0-9+/=]+$'
# a line that only a private key's text block has: its first or last line (PEM: RSA, EC, PKCS#8, encrypted; OpenSSH,
# PGP, SSH2), or a PuTTY key's header, or its Private-Lines: or Private-MAC: line. Either end counts, so a body whose
# first line was read off (a file partly read before `send -`) is still refused
PRIVKEY_RE='-{4,5} ?(BEGIN|END) ([A-Z0-9]+ )*PRIVATE KEY|PuTTY-User-Key-File-[0-9]+:|^Private-(Lines|MAC): '

# printf, not echo, so a value quoted in a message is shown as is
die() { printf 'agent-mailbox: %s\n' "$*" >&2; exit 1; }
warn() { printf 'agent-mailbox: %s\n' "$*" >&2; }
# a global option after the command is refused with a hint wherever an option may appear (never an option's value)
misplaced() { case "$1" in (--as|--as=*|--config|--config=*) die "${1%%=*} goes before the command: agent-mailbox ${1%%=*} <value> $cmd ...";; esac; }
unknown() { misplaced "$1"; die "unknown option $1"; }
# once <option> [<why>]: an option that keeps one value is refused when it's given again, never replaced by the later
# one. Each option loop empties $seen first
once() { case " $seen " in (*" $1 "*) die "$1 was given twice: ${2:-it takes one value}" ;; esac; seen="$seen $1"; }
# matches <ERE> <value>: the whole value, on one line, matches. printf, not echo: dash's echo reads backslash escapes
# (a `\c` would cut the value short), and a line break or carriage return never passes
NL='
' CR=$(printf '\r')
matches() { case "$2" in (*"$NL"*|*"$CR"*) return 1 ;; esac; printf '%s\n' "$2" | grep -Eq -- "$1"; }
# phys <folder>: its physical path. hops <file>: the physical path of the file as named, then of each link it leads to
# (at most 40), one per line (plain readlink is on Linux, macOS, BSD); each hop's folders that are links are followed
# too, so a file under a linked folder shows where that link sits and where it leads. real <file>: the
# file's own physical path. A relative path starting with '-' gets a ./ so no tool reads it as an option
# the path comes from pwd(1), not the shell's builtin: on a file system that ignores case, some shells' builtin (bash's)
# keeps the case the path was typed in, and only the system's getcwd gives the case stored on disk
phys() { (CDPATH= cd -P -- "$1" 2>/dev/null && { pp=$(/bin/pwd -P 2>/dev/null) && [ -n "$pp" ] || pp=$(pwd -P); } &&
  case "$pp" in (//*) pp=${pp#/} ;; esac && printf '%s\n' "$pp"); }
# hops keeps its state in plain variables: run it only in $(...) (it recurses in a subshell)
hops() {
  # a relative path starts from the folder the shell says it's in ($PWD), so a link on the way there counts too.
  # $2: how many folder links deep this call is (8 at most); $3 set: skip the folders above the first hop, which the
  # caller walks itself
  rp=$1 hl=${2:-0} hs=${3:-} pr= hk=; [ "$hl" -le 8 ] || return 1
  case "$rp" in (/*) ;; (*) rp=${PWD:-.}/$rp ;; esac; n=0 h1=$rp
  # a name holding a newline can't be followed exactly ($(...) drops trailing ones): refuse it
  while case "$rp" in (*"$NL"*) return 1 ;; esac; rd=$(phys "$(dirname "$rp")"); do
    printf '%s/%s\n' "${rd%/}" "$(basename "$rp")"; case "$rd" in (/proc|/proc/*) pr=1 ;; esac
    # the hop's folders, from its own up: up to the root, or, for a relative target, up to the folder of the link it
    # came from, which is physical (no links) all the way up. Its last part is cut without a dirname per folder; a
    # path that isn't the plain absolute form (a//b, or relative when PWD is unset) only ends the walk sooner, at . or
    # where cutting leaves it unchanged
    hd=$(dirname "$rp"); [ -z "$hs" ] || hd=/; hs=""
    while [ "$hd" != / ] && [ "$hd" != . ] && [ "$hd" != "$hk" ]; do
      # a folder that's a link: where it sits and everything it leads to
      [ ! -L "$hd" ] || (hops "$hd" $((hl + 1)) 1) || return 1
      hn=${hd%/*}; [ -n "$hn" ] || hn=/; [ "$hn" != "$hd" ] || break; hd=$hn; done
    # the end must be the very file named, or a link was read as a name other than the one stored (macOS's readlink
    # prints some bytes as ?): refuse, not guess. ceiling: a walk through /proc (a pipe on stdin) ends at a name that's
    # no file, so it skips that check. So does /dev/stdin's own link to fd/<n> (macOS, BSD), which names a descriptor;
    # and on macOS a stat of it fails now and then while a pipe's writer exits, so that one walk, from /dev/stdin in one
    # hop, isn't compared either. Any other walk that ends in /dev/fd is. ceiling: on macOS and BSD the walk can't see
    # the file behind a descriptor, so a secret file redirected to stdin, or named as /dev/fd/<n>, is caught only by the
    # private-key check on the body's text (as before: comparing /dev/fd/<n> with /dev/stdin never refused a secret).
    # $PWD names the folder the command runs in: sh, dash and bash keep an inherited PWD only when it's that same
    # folder, so $PWD/<file> and <file> are one file
    if [ ! -L "$rp" ] || [ "$n" -ge 40 ]; then [ -n "$pr" ] || { [ "$h1" = /dev/stdin ] && [ "$n" -eq 1 ] &&
      [ "$rd" = /dev/fd ] && case $(basename "$rp") in (''|*[!0-9]*) false ;; esac; } || [ "$rp" -ef "$h1" ]; return; fi
    rl=$(readlink "$rp" && echo .) || return 1; rl=${rl%.}; rl=${rl%"$NL"}
    # a relative target starts from the link's physical folder, as the kernel reads it, so the folder links above it
    # aren't walked again; but not under /proc, where self names the subshell phys ran in
    n=$((n+1)) hk=; case "$rl" in (/*) rp=$rl ;; (*) case "$rd" in (/proc|/proc/*) rp=$(dirname "$rp")/$rl ;;
      (*) rp=${rd%/}/$rl hk=${rd%/} ;; esac ;; esac; done; return 1
}
real() { rp=$1; case "$rp" in (-*) rp=./$rp ;; esac; n=0
  while [ -L "$rp" ] && [ "$n" -lt 40 ] && rl=$(readlink "$rp" && echo .); do rl=${rl%.}; rl=${rl%"$NL"}; n=$((n+1)); case "$rl" in (/*) rp=$rl ;; (*) rp=$(dirname "$rp")/$rl ;; esac; done
  rd=$(phys "$(dirname "$rp")") && printf '%s/%s\n' "${rd%/}" "$(basename "$rp")"; }
# this script's real path, following links (install.sh links it onto PATH)
here() {
  # a $0 without a slash (bash searched PATH for the script) names no folder: fail rather than guess this one
  case "$0" in (*/*) ;; (*) [ -f "$0" ] || return 1 ;; esac
  real "$0"
}
SELF=$(here) || SELF=""
SELF_DIR=${SELF%/*} SELF_NAME=${SELF##*/}; [ -z "$SELF" ] || [ -n "$SELF_DIR" ] || SELF_DIR=/
# the mailbox folder: a relative path whose parts can't be read as options or reach outside, or into git's own folder
root_ok() { matches '^[A-Za-z0-9._][A-Za-z0-9._-]*(/[A-Za-z0-9._][A-Za-z0-9._-]*)*$' "$ROOT" &&
  case "/$ROOT/" in (*/../*|*/.[Gg][Ii][Tt]/*) false ;; (*) true ;; esac; }
# a branch name git accepts, checked the same way with or without git (the dir adapter doesn't need it): within these
# characters, git refuses a part starting with '.' or ending in '.lock', '..', an empty part (a leading, trailing or
# doubled '/'), a final '.', a leading '-', and HEAD
branch_ok() { matches '^[A-Za-z0-9._/-]+$' "$1" &&
  case "/$1/" in (*/.*|*.lock/*|*..*|*//*|*./|/-*|/HEAD/) false ;; (*) true ;; esac; }
lib_ok() { [ -n "${AGENT_MAILBOX_LIB:-}" ] || [ -n "$SELF_DIR" ]; }
LIB_DIR="${AGENT_MAILBOX_LIB:-$SELF_DIR/../adapters}"
# self_clone: succeeds when this script is bin/agent-mailbox in a clone of agent-mailbox: a repository that tracks it
# there, at its top, beside adapters/git.sh (not one that vendors a copy elsewhere). Never a repository the current
# folder or the environment names: it unsets git's repository variables, so run it in a subshell.
self_clone() {
  # (with no folder, `git -C ""` would use the current one); without git, the commands below fail quietly
  [ -n "$SELF_DIR" ] && [ "$SELF_NAME" = agent-mailbox ] || return 1
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars 2>/dev/null)
  [ "$(git -C "$SELF_DIR" rev-parse --show-prefix 2>/dev/null)" = bin/ ] &&
    git -C "$SELF_DIR" ls-files --error-unmatch -- agent-mailbox ../adapters/git.sh >/dev/null 2>&1
}
# the commit this CLI runs from, with "+changes" when the clone's tracked files are modified; fails outside a clone
self_rev() { (
  self_clone || exit 1
  rev=$(git -C "$SELF_DIR" rev-parse --short HEAD 2>/dev/null) || exit 1
  [ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$SELF_DIR" status --porcelain -uno 2>/dev/null)" ] || rev="$rev+changes"
  printf '%s\n' "$rev"
) }

# --- configuration: flags > environment > config file > defaults ------------------------------------------------
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/agent-mailbox"
STATE="${AGENT_MAILBOX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-mailbox}"
CONFIG="${AGENT_MAILBOX_CONFIG:-$CONFIG_HOME/config}"
AS="" seen=""
while [ $# -gt 0 ]; do
  case "$1" in
    --as) [ $# -ge 2 ] || die "--as needs a name"; once "$1"; AS=$2; shift 2 ;;
    --config) [ $# -ge 2 ] || die "--config needs a file"; once "$1"; CONFIG=$2; shift 2 ;;
    --version) rev=$(self_rev) || rev=""; printf 'agent-mailbox %s (protocol %s%s)\n' "$VERSION" "$PROTOCOL" "${rev:+, $rev}"; exit 0 ;;
    *) break ;;
  esac
done
cfg() { [ -f "$CONFIG" ] && sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" "$CONFIG" | tail -n 1; }
STORE="${AGENT_MAILBOX_STORE:-$(cfg store)}"
ADAPTER="${AGENT_MAILBOX_ADAPTER:-$(cfg adapter)}"; ADAPTER="${ADAPTER:-git}"
ROOT="${AGENT_MAILBOX_ROOT:-$(cfg root)}"; ROOT="${ROOT:-mailbox}"
BRANCH="${AGENT_MAILBOX_BRANCH:-$(cfg branch)}"; BRANCH="${BRANCH:-main}"
# Where a session's name comes from: --as, then AGENT_MAILBOX_NAME, then the name this session's `watch` recorded
# (shells that keep no exports between commands), then the config file.
SESSION="${AGENT_MAILBOX_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}"
# a session id that could name another folder (`.`, `..`, or holding a /) is no session, as the Stop hook reads it
case "$SESSION" in (.|..|*/*) SESSION= ;; esac
session_name() { [ -n "$SESSION" ] && tr -d ' \n' 2>/dev/null < "$STATE/sessions/$SESSION"; }
# session_store <config>|- [also]: record this store and name for this session, so the Claude Code hook watches it;
# with -, that it's retired. Without also, it's the only one the session watches (any other store or name it watched
# is dropped), as `watch` always did; with also (`watch --also`), it's added to them. session-stores/<session id> is a
# log: a line "<store id> <name> <config>" (- for dropped) is appended, so an append can't lose another's, only when it
# changes what the latest one for the store and name says; readers take the latest for each
session_store() { t="$STATE/session-stores/$SESSION"; mkdir -p "$STATE/session-stores"
  if [ "$1" != - ] && [ -z "${2:-}" ]; then
    o=$(SS_K="$STORE_ID $ME" awk '{ k = $1 " " $2; c = $0; sub(/^[^ ]+ [^ ]+ /, "", c); if (!(k in cf)) l[++n] = k; cf[k] = c }
      END { for (i = 1; i <= n; i++) if (cf[l[i]] != "-" && l[i] != ENVIRON["SS_K"]) print l[i] " -" }' "$t" 2>/dev/null)
    [ -z "$o" ] || printf '%s\n' "$o" >> "$t"
  fi
  c=$(SS_K="$STORE_ID $ME" awk 'index($0, ENVIRON["SS_K"] " ") == 1 { c = substr($0, length(ENVIRON["SS_K"]) + 2) }
    END { print c }' "$t" 2>/dev/null)
  [ "$c" = "$1" ] || { [ "$1" = - ] && [ -z "$c" ]; } || printf '%s %s %s\n' "$STORE_ID" "$ME" "$1" >> "$t"; }
ME="${AS:-${AGENT_MAILBOX_NAME:-$(session_name || true)}}"; ME="${ME:-$(cfg name)}"
KEY="${AGENT_MAILBOX_KEY:-$(cfg key)}"; [ -n "$KEY" ] || [ -z "$ME" ] || KEY="$CONFIG_HOME/keys/$ME"

# --- helpers -------------------------------------------------------------------------------------------------------
one_line() { [ "$(printf '%s' "$2" | tr -d '\r\n')" = "$2" ] || die "$1 can't hold a line break"; }
one_line "the state folder (from AGENT_MAILBOX_STATE, XDG_STATE_HOME or HOME)" "$STATE"
valid_name() { one_line name "$1"; matches "$NAME_RE" "$1" || die "'$1' isn't a valid name (lowercase a-z, 0-9, '.', '-'; up to 63)"; }
need_me() { [ -n "$ME" ] || die "no agent name: run setup --name, set AGENT_MAILBOX_NAME, or pass --as"; valid_name "$ME"; }
# other_watcher <pid file>: print the pid of a live watcher the file names for this store (not this process): the pid
# is running, and its command line (/proc, or ps where there's none, as on macOS) is an agent-mailbox watch. That's
# stricter than hooks/claude-watch-guard.sh's alive(), which takes any command line holding agent-mailbox and watch.
# Status 1 when there's none
other_watcher() { set -- $(cat "$1" 2>/dev/null); [ "${3:-}" = "$STORE_ID" ] || return 1
  case "${1:-}" in ''|*[!0-9]*|"$$") return 1 ;; esac
  kill -0 "$1" 2>/dev/null || return 1
  if [ -r "/proc/$1/cmdline" ]; then a=$(tr '\0' ' ' < "/proc/$1/cmdline"); else a=$(ps -p "$1" -o args= 2>/dev/null); fi
  # (watch as an argument of its own after the CLI: a hook script, or a name with "watch" inside it, isn't a watcher;
  # a name that is just "watch" still matches)
  case "$a " in *agent-mailbox*" watch "*) echo "$1" ;; *) return 1 ;; esac; }
# no_mail: an empty inbox, said so (exit 3); unless the name has no record in this mailbox, which more likely means the
# wrong name (another store's, or the one a session's watch recorded) than no mail (exit 1). A retired name has its record
no_mail() { [ -f "$(record "$ME")" ] ||
  die "'$ME' isn't registered in this mailbox: check the name (pass --as, or see whoami for the one in use), or register"
  echo "no mail for $ME"; exit 3; }
stamp_iso() { echo "$1" | sed -E 's/^(....)(..)(..)T(..)(..)(..)Z$/\1-\2-\3T\4:\5:\6Z/'; }
# OpenSSH 8.1+ lists `ssh-keygen -Y sign` in its usage; older versions don't (ERE, so BSD grep reads it the same)
have_ssh() { command -v ssh-keygen >/dev/null 2>&1 && ssh-keygen -Y 2>&1 | grep -Eq 'ssh-keygen -Y (sign|verify)'; }
# header value of a field from a front-matter file (first occurrence, inside the --- block only)
# a header that never closes isn't a header (PROTOCOL.md section 5): every field reads empty
field() { awk -v k="$1" 'NR == 1 && $0 != "---" { exit } NR > 1 && $0 == "---" { closed = 1; exit }
  NR > 1 && !done { i = index($0, ":"); if (i && substr($0, 1, i - 1) == k) { v = substr($0, i + 1); sub(/^ /, "", v); done = 1 } }
  END { if (closed && done) print v }' "$2"; }
# claim <human|env|groups> <record>: that field of an agent's record when it's well formed (a name, or for groups up
# to 16 names), else nothing: a value that isn't counts as absent (PROTOCOL.md section 4)
claim() { cv=$(field "$1" "$2" 2>/dev/null); case "$1" in (groups) matches "$GROUPS_RE" "$cv" ;; (*) matches "$NAME_RE" "$cv" ;; esac &&
  printf '%s\n' "$cv"; }
# valid_claim <option> <value>: refuse a --human, --env or --groups value that isn't well formed (empty clears it)
valid_claim() { [ -n "$2" ] || return 0
  case "$1" in (--groups) matches "$GROUPS_RE" "$2" || die "--groups takes up to 16 names (lowercase a-z, 0-9, '.', '-'; up to 63 each), separated by spaces, not '$2'" ;;
    (*) matches "$NAME_RE" "$2" || die "$1 takes one name (lowercase a-z, 0-9, '.', '-'; up to 63), not '$2'" ;; esac; }
# write $2 to $1 atomically: a temp file in the same directory, then a rename
# put and put_signed clear their temp paths, then create them with noclobber (set -C), so a link left at a guessable
# temp name isn't followed, and check each temp is a plain file right before moving it into place, so a link found there
# then isn't published. ceiling: a writer racing a live run can still have a write land on a device or FIFO behind a
# link swapped in between the clear and the write, or swap a link in between the check and the move; that's outside the
# security model (docs/security.md)
put() { [ ! -d "$1" ] || die "$(rel "$1") isn't a file"; tmp="$1.tmp.$$"
  { rm -f "$tmp" && [ ! -L "$tmp" ]; } || die "can't clear $(rel "$tmp")"
  (set -C; printf '%s\n' "$2" > "$tmp") 2>/dev/null && plain "$tmp" || { rm -f "$tmp"; die "can't write $(rel "$1")"; }
  if [ -n "$PUT_NEW" ]; then
    if land "$tmp" "$1"; then :; else lr=$?; rm -f "$tmp"; [ "$lr" != 1 ] || taken "$1"; die "can't write $(rel "$1")"; fi
  else mv -f "$tmp" "$1" || { rm -f "$tmp"; die "can't write $(rel "$1")"; }; fi; }
# PUT_NEW (set by send): put and put_signed publish a new file without replacing one that's there. In a dir store two
# sends can pick the same file name at once (one name, one topic, one second); each checks the name is free, and a
# rename would let the second overwrite the first. land <temp> <file> hard-links the temp to the file, which fails if
# the file exists, then removes the temp: 0 when it landed, 1 when the file was taken, 2 when the fallback rename
# failed (the temp is removed). ceiling: a file system without hard links (some synced or FAT folders) falls back to the
# rename, and keeps the race
PUT_NEW=""
land() { if ln "$1" "$2" 2>/dev/null; then rm -f "$1"; return 0; fi
  { [ -e "$2" ] || [ -L "$2" ]; } && return 1
  mv -f "$1" "$2" || { rm -f "$1"; return 2; }; }
# taken <file>: stop, because another writer published that file name first
taken() { die "$(rel "$1") exists (another send took this file name in the same second; send again)"; }
# plain <path>...: each is a regular file, not a link
plain() { for pf; do [ -f "$pf" ] && [ ! -L "$pf" ] || return 1; done; }
# set_cfg <key> <value>: replace or add one line of the config file
set_cfg() {
  one_line "$1" "$2"; mkdir -p "$(dirname "$CONFIG")" || die "can't create $(dirname "$CONFIG")"
  rest=$( [ -f "$CONFIG" ] && grep -v "^$1[[:space:]]*=" "$CONFIG" ); put "$CONFIG" "$(printf '%s\n%s = %s' "$rest" "$1" "$2" | sed '/^$/d')"
}
sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -c1-16; else shasum -a 256 | cut -c1-16; fi; }
# Text from the store is shown with the characters that move the cursor or reorder a line spelled out, so it can't
# overwrite a line or disguise what it says: C0 controls but tab and line feed, DEL and NUL as \xNN; C1 controls,
# Unicode's bidi embeddings, overrides and isolates, its line/paragraph separators and its tag characters as <U+XXXX>. A carriage return
# just before a line feed (Windows line endings) is dropped. ESC is a sed script for LC_ALL=C (byte by byte, the same
# in GNU and BSD sed), built with printf's octal escapes.
esc_script() {
  c0="" n=1; while [ $n -le 31 ]; do [ $n = 9 ] || [ $n = 10 ] || c0="$c0 $n $n"; n=$((n+1)); done
  c1="" n=128; while [ $n -le 159 ]; do c1="$c1 $n $n"; n=$((n+1)); done
  # <second byte> <third byte> <code point> of each three-byte (E2 xx xx) character
  u=""; for b in 168 169 170 171 172 173 174; do u="$u 128 $b $((8064 + b))"; done
  for b in 166 167 168 169; do u="$u 129 $b $((8128 + b))"; done
  # <third byte> <fourth byte> <code point> of each tag character (U+E0000-E007F, F3 A0 xx xx), which can carry text
  # a reader never sees
  t=""; for c in 128 129; do b=128; while [ $b -le 191 ]; do t="$t $c $b $((917504 + (c - 128) * 64 + b - 128))"; b=$((b+1)); done; done
  # shellcheck disable=SC2086
  printf "$(printf 's/\\015$//\\n/[\\001-\\010\\013-\\037\\177\\302\\342\\363\\377]/{\\n'
    printf 's/\\%03o/\\\\\\\\x%02x/g\\n' $c0 127 127 255 0
    printf 's/\\302\\%03o/<U+%04X>/g\\n' $c1
    printf 's/\\342\\%03o\\%03o/<U+%04X>/g\\n' $u
    printf 's/\\363\\240\\%03o\\%03o/<U+%05X>/g\\n' $t; printf '}')"
}
ESC=$(esc_script)
# clean [<sed script>]: stdin to stdout, escaped as above, then the optional script. tr maps NUL (which sed can't
# name and a shell's $(...) drops) to 0xff, which ESC shows as \x00. ceiling: a raw 0xff byte (never in UTF-8 text)
# shows as \x00 too, and stray 0x80-0xff bytes that aren't UTF-8 pass as is; escaping them needs a UTF-8 decoder.
clean() { LC_ALL=C tr '\000' '\377' | LC_ALL=C sed -e "$ESC" ${1:+-e "$1"}; }
# CAP: a sed script for LC_ALL=C that cuts a line longer than 200 bytes to 200, without splitting a UTF-8
# character, and marks the cut with "..."
CAP=$(printf '/^.\\{201\\}/{\ns/^\\(.\\{200\\}\\).*/\\1/\ns/[\300-\337]$//\ns/[\340-\357][\200-\277]\\{0,1\\}$//\ns/[\360-\367][\200-\277]\\{0,2\\}$//\ns/$/.../\n}')

# --- the store, through its adapter (contract: adapters/README.md) --------------------------------------------------
load_adapter() {
  lib_ok || die "can't find the folder this script is in ($0); set AGENT_MAILBOX_LIB"
  root_ok || die "root must be a relative path of letters, digits, '.', '_' and '-' (no part '..' or '.git' in any case, or starting with '-'), not '$ROOT'"
  branch_ok "$BRANCH" || die "bad branch name '$BRANCH' (from ${AGENT_MAILBOX_BRANCH:+AGENT_MAILBOX_BRANCH, which overrides }the config)"
  [ -n "$STORE" ] || die "no store configured: run 'agent-mailbox setup --store <url|path>' (or set AGENT_MAILBOX_STORE)"
  one_line "the store (from ${AGENT_MAILBOX_STORE:+AGENT_MAILBOX_STORE, which overrides }the config)" "$STORE"
  matches '^[a-z0-9-]+$' "$ADAPTER" || die "bad adapter name '$ADAPTER'"
  [ -f "$LIB_DIR/$ADAPTER.sh" ] || die "no adapter '$ADAPTER' (looked in $LIB_DIR)"
  STORE_ID=$(printf '%s' "$STORE|$ROOT|$BRANCH" | sha)
  # shellcheck source=/dev/null
  . "$LIB_DIR/$ADAPTER.sh"
  ad_open
  M="$AD_DIR/$ROOT"
}
need_store() {
  [ -f "$M/store.md" ] || die "the store has no mailbox at '$ROOT/' yet (start one with 'agent-mailbox init', if that's what you were asked to do)"
  v=$(field protocol "$M/store.md"); case "$v" in ''|*[!0-9]*) die "store.md has no valid protocol version" ;; esac
  [ "$v" -le "$PROTOCOL" ] || die "this mailbox uses protocol $v; this client speaks $PROTOCOL (upgrade agent-mailbox)"
}
# a store seen requiring signatures stays strict for this reader (pinned like a key), so an edit to store.md can't
# turn signatures off; `trust --relax` lifts the pin after checking with the store's owner
require_sigs() {
  pin="$STATE/pins/$STORE_ID/.strict"
  if [ "$(field require_signatures "$M/store.md")" = true ]; then
    [ -f "$pin" ] || { mkdir -p "$STATE/pins/$STORE_ID" && : > "$pin"; }; return 0; fi
  [ -f "$pin" ] || return 1
  warn "store.md no longer requires signatures; still treating this store as strict (after checking with its owner: trust --relax)"
}
record() { printf '%s\n' "$M/agents/$1.md"; }
# reg_key <record file>: the key the record names, or nothing when it names none or the value isn't a plain key
reg_key() { rk=$(field key "$1" 2>/dev/null); matches "$KEY_RE" "$rk" && printf '%s\n' "$rk"; }
# fingerprint <public key>: its SHA256 fingerprint, as ssh-keygen -l prints it, for comparing out of band; empty
# without ssh-keygen. fpnote <public key>: that, or a note when ssh-keygen can't read the key
fingerprint() { printf '%s\n' "$1" | ssh-keygen -lf - 2>/dev/null | cut -d' ' -f2; }
fpnote() { fn=$(fingerprint "$1"); [ -n "$fn" ] || ! have_ssh || fn="ssh-keygen can't read this key"; printf '%s' "$fn"; }
active() { [ -f "$(record "$1")" ] && [ "$(field status "$(record "$1")")" = active ]; }
# you must be active to send or watch; a retired agent is told how to come back
need_active_me() { active "$ME" && return 0; [ -f "$(record "$ME")" ] && die "'$ME' (you) is retired in this mailbox: run 'update --status active' to come back"
  die "'$ME' (you) isn't registered in this mailbox: register first (JOIN.md)"; }
# (names are listed one per line, so a name with a line break in it is skipped)
inbox_files() { [ -d "$M/inbox/$1" ] || return 0
  find "$M/inbox/$1" -maxdepth 1 -type f -name '*.md' ! -name "*$NL*" | sort | while IFS= read -r p; do
    basename "$p" | grep -Eq "$MSG_RE" && printf '%s\n' "$p"; done; }
# no_link <path>: refuse to write at or under <path> when any part of it below the store's own folder is a symlink,
# so a link a writer plants in a shared store can't redirect writes outside it
no_link() {
  sub=${1#"$AD_DIR"/}; cur=$AD_DIR
  for part in $(echo "$sub" | tr '/' ' '); do
    cur="$cur/$part"; [ -L "$cur" ] && die "refusing to write through a symlink in the store: $(rel "$cur")"
  done; return 0
}
valid_msg() { matches "$MSG_RE" "$1" || die "'$1' isn't a message file name"; }
rel() { if [ -n "${AD_DIR:-}" ]; then case $1 in ("$AD_DIR"/*) printf '%s\n' "${1#"$AD_DIR"/}"; return ;; esac; fi; printf '%s\n' "$1"; }
# secret_file <file>: the file as named, or any link on the way to it, is in ~/.ssh (this HOME's, or the account's own
# when HOME is elsewhere) or this CLI's config or state folder, or is (or is under) where a link kept in ~/.ssh or the
# config folder leads (set in SF); or the file is the same file as the CLI's config file or signing key (either half;
# SF empty), by path or as a file (a hard link, or a name in another case on a file system that ignores case); or its
# path can't be followed to the end (SF is -), or a folder whose links are checked holds one whose path has a line break
# (SF is !<folder>). Then `send` won't mail it out, however it's asked to.
# ceiling: a deny-list of the obvious places, not a guarantee; only the agent's human knows every secret on the machine.
# Another name for a protected file by a hard link, or through a bind mount, is caught (by -ef) for the config file and
# key, and for the file a link kept in ~/.ssh or the config folder leads to, but not for a file inside a protected
# folder. The state folder's links aren't followed out: the CLI keeps none there
secret_file() {
  # a path hops can't follow to the end counts as secret: refuse rather than guess
  SF=""; sp=$(hops "$1") || { SF=-; return 0; }; sp="$NL$sp$NL"
  # (the body as a file, found here: inside the find pipeline below, a body named /dev/stdin would be find's pipe)
  bf=$(real "$1") || bf=$1
  # the account's own home, from its login name (a name that's safe to expand with ~), when HOME isn't it
  ah=""; an=$(id -un 2>/dev/null) && matches '^[A-Za-z0-9._][A-Za-z0-9._-]*$' "$an" && eval "ah=~$an" &&
    case "$ah" in (/*) [ "$ah" != "${HOME:-}" ] || ah="" ;; (*) ah="" ;; esac
  for SF in "${HOME:+$HOME/.ssh}" "${ah:+$ah/.ssh}" "$CONFIG_HOME" "$STATE"; do
    [ -n "$SF" ] && sd=$(phys "$SF") || continue
    case "$sp" in (*"$NL${sd%/}"/*) return 0 ;; esac
    # where a link kept in ~/.ssh or the config folder leads (a ~/.ssh/config from a dotfiles folder, say): that file,
    # or anything under that folder, named directly, at any hop of the walk. A link to a folder is resolved as a folder,
    # whatever its target says (a trailing /, a .., a link on the way). ceiling: a link to a folder that holds the
    # protected folder itself (~ or /) is skipped, since every file under it would be refused; and only links kept in
    # those folders count, not a link inside the folder one leads to, when its own target is named directly
    [ "$SF" != "$STATE" ] || continue
    # (the links are read one per line, so a link whose path holds a line break, in its own name or a folder's on the
    # way, can't be checked: refuse, naming the folder)
    [ -z "$(find "$sd" -type l -path "*$NL*" 2>/dev/null)" ] || { SF="!$SF"; return 0; }
    # (a link whose target is the body itself, as a file, by another name, a hard link say, counts by the body's own path)
    lts=$(find "$sd" -type l 2>/dev/null | while IFS= read -r l; do
      if [ -d "$l" ]; then phys "$l"; elif [ "$1" -ef "$l" ] || [ "$bf" -ef "$l" ]; then printf '%s\n' "$bf"; else real "$l"; fi; done)
    while IFS= read -r lt; do
      # (a link to / leads to every file: hops shows a hop that is / itself as //, which it would match)
      case "$lt" in (/) continue ;; esac; case "$sd/" in ("$lt"/*) continue ;; esac
      case "$sp" in (*"$NL$lt$NL"*|*"$NL$lt/"*) SF="$lt, where a link in $SF leads"; return 0 ;; esac
    done <<EOF_LINKS
$lts
EOF_LINKS
  done; SF=""
  for sk in "$CONFIG" "$KEY" "${KEY:+$KEY.pub}"; do [ -n "$sk" ] || continue
    rk=$(real "$sk") && case "$sp" in (*"$NL$rk$NL"*) return 0 ;; esac
    [ ! -e "$sk" ] || [ ! "$1" -ef "$sk" ] || return 0
  done
  return 1
}

# --- signatures ----------------------------------------------------------------------------------------------------
# verify_file and verify_sig print one word: verified | unsigned | bad | nokey | changed | misrouted
# hdr_ok <file>: its header closes, and every line in it is a plain `key: value` (a key of lowercase letters, digits,
# _ and -, then a colon), with no key twice: one reading, the one `field` gives
hdr_ok() { awk 'NR == 1 { if ($0 != "---") exit 1; next } $0 == "---" { c = 1; exit }
  { i = index($0, ":"); k = substr($0, 1, i - 1)
    if (k !~ /^[a-z0-9_-]+$/ || (k in seen)) exit 1; seen[k] = 1 }
  END { exit c ? 0 : 1 }' "$1"; }
# verify_file <message path> [<inbox it sits in>]: a message whose header isn't plain reads bad; otherwise as verify_sig
verify_file() { hdr_ok "$1" || { echo bad; return; }; verify_sig "$@"; }
# verify_sig <message path> [<inbox it sits in>]: its signature alone, whatever else its header holds
verify_sig() {
  f=$1 inb=${2:-}
  from=$(field from "$f"); to=$(field to "$f")
  matches "$NAME_RE" "$from" && matches "$NAME_RE" "$to" || { echo bad; return; }
  [ -z "$inb" ] || [ "$to" = "$inb" ] || { echo misrouted; return; }
  # (a .sig that's a link isn't the message's own signature, as read's copy, which skips one, would also say)
  { [ -f "$f.sig" ] && [ ! -L "$f.sig" ]; } || { echo unsigned; return; }
  rec=$(record "$from"); [ -f "$rec" ] || { echo nokey; return; }
  pub=$(reg_key "$rec"); [ -n "$pub" ] || { echo nokey; return; }
  have_ssh || { echo nokey; return; }
  # trust on first use: pin the key's fingerprint per store; a different key later is "changed" until `trust`
  pins="$STATE/pins/$STORE_ID"; mkdir -p "$pins"
  fp=$(printf '%s\n' "$pub" | sha)
  if [ -f "$pins/$from" ]; then [ "$(cat "$pins/$from")" = "$fp" ] || { echo changed; return; }
  else echo "$fp" > "$pins/$from"; fi
  allowed="$STATE/tmp.allowed.$$"; mkdir -p "$STATE"
  printf '%s %s\n' "$from" "$pub" > "$allowed"
  if ssh-keygen -Y verify -f "$allowed" -I "$from" -n "$NS" -s "$f.sig" < "$f" >/dev/null 2>&1; then r=verified; else r=bad; fi
  rm -f "$allowed"; echo "$r"
}
# sign_file <file>: write <file>.sig, created with noclobber so a link at that name is never followed
sign_file() { if askpass_never; then (set -C; SSH_ASKPASS_REQUIRE=never ssh-keygen -Y sign -q -n "$NS" -f "$KEY" < "$1" > "$1.sig") 2>/dev/null
  else (set -C; ssh-keygen -Y sign -q -n "$NS" -f "$KEY" < "$1" > "$1.sig") 2>/dev/null; fi || die "signing failed with $KEY"; }
# askpass_never: signing reads the message on stdin, so ssh-keygen asks for a key's passphrase through an askpass
# program whenever DISPLAY is set, even in a terminal. When this command's own stdin is a terminal and
# SSH_ASKPASS_REQUIRE isn't set, sign with SSH_ASKPASS_REQUIRE=never, so the passphrase is asked in the terminal.
# OpenSSH 8.4 added that variable; older versions keep their own behaviour
askpass_never() { [ -t 0 ] && [ -z "${SSH_ASKPASS_REQUIRE+set}" ] || return 1
  v=$(ssh -V 2>&1 | sed -n 's/^OpenSSH_\([0-9]*\)\.\([0-9]*\).*/\1 \2/p')
  [ -n "$v" ] && { set -- $v; [ "$1" -gt 8 ] || { [ "$1" -eq 8 ] && [ "$2" -ge 4 ]; }; }; }
# put_signed <file> <content> [<key>]: sign a temp copy and put the .sig in place before the file, so a new file never
# shows without its signature; with <key>, the signature must verify against it first. A failed signing or check
# leaves neither behind.
# ceiling: replacing a file that exists (a registry record) shows the new .sig beside the old file for a moment in a
# dir store; only an atomic multi-file publish in the adapter would close that. And a writer racing a live run can
# swap the destination for a link to a folder between the check and the final mv; mv -T (not portable) would close
# that. Both are outside the security model (docs/security.md: writers to a store trust each other)
put_signed() { ps="$1.tmp.$$"; [ ! -L "$1.sig" ] || rm -f "$1.sig"
  for pd in "$1" "$1.sig"; do [ ! -d "$pd" ] || die "$(rel "$pd") isn't a file"; done
  for pd in "$ps" "$ps.sig" "$ps.old" "$ps.ok"; do { rm -f "$pd" && [ ! -L "$pd" ]; } || die "can't clear $(rel "$pd")"; done
  (set -C; printf '%s\n' "$2" > "$ps") 2>/dev/null || { rm -f "$ps"; die "can't write $(rel "$1")"; }
  (sign_file "$ps") || { rm -f "$ps" "$ps.sig"; exit 1; }
  if [ -n "${3:-}" ]; then
    { (set -C; printf '%s %s\n' "$ME" "$3" > "$ps.ok") 2>/dev/null &&
      ssh-keygen -Y verify -f "$ps.ok" -I "$ME" -n "$NS" -s "$ps.sig" < "$ps" >/dev/null 2>&1; } ||
      { rm -f "$ps" "$ps.sig" "$ps.ok"; die "the signature made with $KEY doesn't verify against your registry record's key"; }
    rm -f "$ps.ok"
  fi
  # a new file (PUT_NEW) never replaces anything: it lands its .sig first, and a .sig already at that name means
  # another send took the name (it may have landed while this one signed). If the file name is then taken, only its own
  # .sig is removed, so the winner's pair is left as it was
  if [ -n "$PUT_NEW" ]; then
    plain "$ps" "$ps.sig" || { rm -f "$ps" "$ps.sig"; die "can't write $(rel "$1")"; }
    if land "$ps.sig" "$1.sig"; then :; else
      lr=$?; rm -f "$ps" "$ps.sig"; [ "$lr" != 1 ] || taken "$1"; die "can't write $(rel "$1")"; fi
    if land "$ps" "$1"; then return 0; else lr=$?; fi
    rm -f "$ps" "$1.sig"; [ "$lr" != 1 ] || taken "$1"; die "can't write $(rel "$1")"
  fi
  # a failed move puts back the signature the file had (none, for a new file), so the pair still verifies
  # (only a regular file is kept: a .sig that's a link is replaced, never read, so nothing outside the store is copied in)
  old=; if [ -f "$1.sig" ] && [ ! -L "$1.sig" ]; then
    (set -C; cat "$1.sig" > "$ps.old") 2>/dev/null && old=1 || { rm -f "$ps" "$ps.sig" "$ps.old"; die "can't write $(rel "$1")"; }; fi
  if plain "$ps" "$ps.sig" && mv -f "$ps.sig" "$1.sig" && mv -f "$ps" "$1"; then rm -f "$ps.old"; return 0; fi
  rm -f "$ps" "$ps.sig"; if [ -n "$old" ]; then mv -f "$ps.old" "$1.sig"; else rm -f "$1.sig"; fi
  die "can't write $(rel "$1")"; }
can_sign() { [ -f "$KEY" ] && have_ssh; }
# new_keep <path>: create an inbox's .keep with noclobber, so a link left at its name isn't followed (another send
# creating the same .keep at the same moment is fine: a plain file there is what's wanted). ceiling: as for put, a
# link to a device or FIFO swapped in by a writer racing a live run can still be opened
new_keep() { (set -C; : > "$1") 2>/dev/null || plain "$1" || die "can't create $(rel "$1")"; }
# own_pub: the public half of $KEY as "<type> <base64>", derived from the key, or from $KEY.pub for one with a passphrase
own_pub() { op=$(ssh-keygen -y -P '' -f "$KEY" 2>/dev/null | cut -d' ' -f1,2); matches "$KEY_RE" "$op" || op=$(cut -d' ' -f1,2 "$KEY.pub" 2>/dev/null)
  printf '%s\n' "$op"; }

# --- commands ------------------------------------------------------------------------------------------------------
cmd="${1:-help}"; [ $# -gt 0 ] && shift
# reply answers a message in your inbox: it reads the addressee (the message's sender) and topic from the message, then
# runs as send with --in-reply-to and --consume naming it, so the answer and the receipt are one change (PROTOCOL.md
# section 5). The store is opened here, once, and send goes on from it (LOADED)
LOADED=""
if [ "$cmd" = reply ]; then
  ru='usage: reply <file> <body.md|-> [--needs text] [--context c] [--hold|--release "<item> <version>"] [--keep]'
  [ $# -ge 1 ] || die "$ru"
  case "$1" in (-*) misplaced "$1"; matches "$MSG_RE" "$1" || die "$ru" ;; esac
  rf=$(basename -- "$1"); shift; rbody="" keep="" seen=""
  # what isn't reply's own is kept, in order, for send: each option with its value
  n=$#; while [ "$n" -gt 0 ]; do a=$1; shift; n=$((n-1))
    case "$a" in
      (--keep) once "$a"; keep=1 ;;
      (--needs|--context|--hold|--release) [ "$n" -ge 1 ] || die "$a needs a value"; set -- "$@" "$a" "$1"; shift; n=$((n-1)) ;;
      (-) [ -z "$rbody" ] || die "reply takes one message and one body, not '$a' too"; rbody=- ;;
      (-*) unknown "$a" ;;
      (*) [ -z "$rbody" ] || die "reply takes one message and one body, not '$a' too"; rbody=$a ;;
    esac
  done
  [ -n "$rbody" ] || die "$ru"
  need_me; valid_msg "$rf"
  load_adapter; ad_sync; need_store; LOADED=1
  rp="$M/inbox/$ME/$rf"
  # (a link isn't a message of your inbox's, as for read)
  plain "$rp" || die "not in your inbox: $rf"
  hdr_ok "$rp" || die "$rf has a header that isn't plain (verify reads it bad), so reply can't tell who sent it; answer with send if you mean to"
  rfrom=$(field from "$rp") rtopic=$(field topic "$rp")
  matches "$NAME_RE" "$rfrom" || die "$rf has no valid from: header, so reply can't tell who sent it"
  matches "$NAME_RE" "$rtopic" || die "$rf has no valid topic: header to reply on"
  # the header says who sent a message, and its file name (<stamp>-<from>-<topic>.md) must agree, as read checks (names
  # may hold '-', so which part is off can't always be told: the note says what the name should be, as read's does)
  st='[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z'
  case "$rf" in ($st-"$rfrom-$rtopic".md) ;;
    (*) die "$rf: its file name doesn't name it as from $rfrom about $rtopic; answer with send if you mean to" ;;
  esac
  # its signature, as read shows it. In a strict store only verified mail counts (as for holds), so reply answers only a
  # message that verifies. Elsewhere a message that reads bad, changed or misrouted is refused too, since consuming it
  # would remove the sign of tampering unseen; unsigned and nokey are answered, with the status said
  v=$(verify_file "$rp" "$ME")
  if require_sigs; then
    [ "$v" = verified ] || die "this store requires signatures, and $rf doesn't verify ($v; see verify); answer with send if you mean to"
  else case "$v" in
    (verified) ;;
    (unsigned|nokey) warn "$rf reads $v (see verify); answering it anyway, as this store doesn't require signatures" ;;
    (*) die "$rf reads $v (see verify), so reply won't answer or consume it; answer with send if you mean to" ;;
  esac; fi
  [ -n "$keep" ] || set -- --consume "$rf" "$@"
  set -- "$rfrom" "$rtopic" "$rbody" --in-reply-to "$rf" "$@"; cmd=send
fi
case "$cmd" in
setup)
  store="$STORE" adapter="$ADAPTER" root="$ROOT" branch="$BRANCH" name="${AS:-$(cfg name)}" human=$(cfg human) hset="" seen=""
  while [ $# -gt 0 ]; do
    misplaced "$1"; [ $# -ge 2 ] || die "$1 needs a value"; once "$1"
    case "$1" in --store) store=$2 ;; --adapter) adapter=$2 ;; --root) root=$2 ;; --branch) branch=$2 ;;
                 --name) name=$2 ;; --human) human=$2 hset=1 ;; *) unknown "$1" ;; esac; shift 2
  done
  [ -n "$store" ] || die "usage: setup --store <url|path> [--adapter git|dir] [--root <dir>] [--branch <b>] [--name <me>] [--human <h>]"
  [ -z "$name" ] || valid_name "$name"
  # (only a --human given is refused; a config's own that isn't a name is dropped, saying so)
  if [ -n "${hset:-}" ]; then valid_claim --human "$human"
  elif [ -n "$human" ] && ! matches "$NAME_RE" "$human"; then warn "dropping the config's human '$human': it isn't a name (set one with --human)"; human=""; fi
  for v in store:"$store" adapter:"$adapter" root:"$root" branch:"$branch"; do one_line "${v%%:*}" "${v#*:}"; done
  [ -z "$branch" ] || branch_ok "$branch" || die "bad branch name '$branch': pass --branch <name>"
  mkdir -p "$(dirname "$CONFIG")" || die "can't create $(dirname "$CONFIG")"
  put "$CONFIG" "$(printf '# agent-mailbox config (one key = value per line)\nstore = %s\nadapter = %s\nroot = %s\nbranch = %s\n%s' \
    "$store" "$adapter" "$root" "$branch" "${name:+name = $name
}${human:+human = $human
}")"
  printf 'wrote %s\n' "$CONFIG"
  # pinned keys (and a strict store's pin) belong to the store's settings as written: new settings, even the same
  # mailbox spelled another way, start with none, so say so when the old settings had some (setup can't tell a
  # re-spelled address from another mailbox, so it carries nothing over)
  if [ -n "$STORE" ] && [ "$STORE|$ROOT|$BRANCH" != "$store|${root:-mailbox}|${branch:-main}" ] &&
    [ -n "$(ls -A "$STATE/pins/$(printf '%s' "$STORE|$ROOT|$BRANCH" | sha)" 2>/dev/null)" ]; then
    warn "your pinned keys (and a strict store's pin) stay with the old store settings; for the same mailbox, keep its address as first written"
  fi ;;
init)
  req=false title="agent mailbox" seen=""
  while [ $# -gt 0 ]; do
    case "$1" in --require-signatures) req=true; shift ;; --title) [ $# -ge 2 ] || die "--title needs text"; once "$1"; title=$2; shift 2 ;;
                 *) unknown "$1" ;; esac
  done
  one_line title "$title"
  load_adapter; ad_sync
  [ -f "$M/store.md" ] && die "a mailbox already exists at '$ROOT/' in this store"
  no_link "$M/agents/.keep"; no_link "$M/inbox/.keep"; no_link "$M/store.md"
  mkdir -p "$M/agents" "$M/inbox"; : > "$M/agents/.keep"; : > "$M/inbox/.keep"
  ours=$(printf -- '---\nprotocol: %s\ntitle: %s\nrequire_signatures: %s\ncreated: %s\n---\n\nThis folder is an agent mailbox. Spec: https://github.com/nesquena/agent-mailbox/blob/main/PROTOCOL.md\n' \
    "$PROTOCOL" "$title" "$req" "$(date -u +%Y-%m-%dT%H:%M:%SZ)")
  put "$M/store.md" "$ours"
  # another agent's init can win the race while this one publishes: AD_INIT lets the git adapter drop this commit, and
  # only this one, and the store keeps the winner's settings, which may differ
  AD_INIT=1; ad_commit "mailbox: init" "$ROOT/store.md" "$ROOT/agents/.keep" "$ROOT/inbox/.keep"; AD_INIT=""
  [ "$(cat "$M/store.md" 2>/dev/null)" = "$ours" ] ||
    die "another agent initialized the mailbox at '$ROOT/' first, so this init was dropped; its settings are in $ROOT/store.md (title: $(field title "$M/store.md" | clean "$CAP"), require_signatures: $(field require_signatures "$M/store.md" | clean "$CAP"))"
  echo "initialized a mailbox at '$ROOT/' (require_signatures: $req)" ;;
register|update)
  need_me; load_adapter; ad_sync; need_store
  rec=$(record "$ME"); kind="" about="" runs="" watchv="" status="" keyfile="" nokey="" force="" seen=""
  human="" envw="" groups="" hset="" eset="" gset=""
  while [ $# -gt 0 ]; do
    case "$1" in --no-key) nokey=1; shift; continue ;; --force) [ "$cmd" = update ] || unknown "$1"; force=1; shift; continue ;; esac
    misplaced "$1"; [ $# -ge 2 ] || die "$1 needs a value"; once "$1"
    case "$1" in --kind) kind=$2 ;; --about) about=$2 ;; --runs-on) runs=$2 ;; --watch) watchv=$2 ;;
                 --status) status=$2 ;; --key) keyfile=$2 ;;
                 --human) human=$2 hset=1 ;; --env) envw=$2 eset=1 ;;
                 --groups) groups=$(printf '%s\n' "$2" | tr '\t' ' ' | tr -s ' ' | sed 's/^ //; s/ $//') gset=1
                   [ -n "$groups" ] || [ -z "$2" ] || die "--groups takes names separated by spaces, or \"\" to clear them" ;;
                 *) unknown "$1" ;; esac; shift 2
  done
  valid_claim --human "$human"; valid_claim --env "$envw"; valid_claim --groups "$groups"
  [ "$cmd" = register ] || [ -z "$keyfile$nokey" ] || die "update can't change a key; see JOIN.md's \"Replacing your key\""
  [ -z "$keyfile" ] || [ -z "$nokey" ] || die "register takes --key <pub> or --no-key, not both"
  if [ "$cmd" = register ]; then
    [ -f "$rec" ] && die "'$ME' is already registered (names are unique; use 'update' to change your record)"
    [ -n "$kind" ] && [ -n "$about" ] || die "usage: register --kind <kind> --about <text> [--runs-on <text>] [--watch <text>] [--key <pub>|--no-key] [--human <h>] [--env <e>] [--groups \"<g> ...\"]"
    status=active
    # (the config's human, from setup --human, unless --human was given)
    [ -n "$hset" ] || { human=$(cfg human)
      [ -z "$human" ] || matches "$NAME_RE" "$human" || { warn "your config's human isn't a name, so none is recorded (set one with setup --human)"; human=""; }; }
  else
    [ -f "$rec" ] || die "'$ME' isn't registered yet (use 'register')"
    kind="${kind:-$(field kind "$rec")}"; about="${about:-$(field about "$rec")}"; runs="${runs:-$(field runs_on "$rec")}"
    watchv="${watchv:-$(field watch "$rec")}"; status="${status:-$(field status "$rec")}"
    # (one not passed keeps its value, as it is; an empty one passed clears it)
    [ -n "$hset" ] || human=$(field human "$rec"); [ -n "$eset" ] || envw=$(field env "$rec")
    [ -n "$gset" ] || groups=$(field groups "$rec")
  fi
  case "$status" in active|retired) ;; *) die "status is active or retired" ;; esac
  # an agent retires once its inbox is empty (PROTOCOL.md section 4): mail still waiting would no longer wake it.
  # --force retires anyway, leaving that mail unread
  if [ "$cmd" = update ] && [ "$status" = retired ] && [ "$(field status "$rec")" != retired ] && [ -z "$force" ]; then
    left=$(inbox_files "$ME" | while IFS= read -r p; do basename "$p"; done)
    if [ -n "$left" ]; then nl=$(printf '%s\n' "$left" | grep -c .)
      shown=$(printf '%s\n' "$left" | head -n 5 | tr '\n' ' '); [ "$nl" -le 5 ] || shown="$shown(and $((nl - 5)) more) "
      die "your inbox still holds $nl message(s): $shown- read and consume them first (sending on to another agent, as new mail, any that are its job), or pass --force to retire with them unread"
    fi
  fi
  for v in kind:"$kind" about:"$about" runs_on:"$runs" watch:"$watchv" human:"$human" env:"$envw" groups:"$groups"; do
    one_line "${v%%:*}" "${v#*:}"; done
  pub="" own="" newkey=""
  if [ "$cmd" = update ]; then
    # an agent holding its key never re-signs a record whose key someone else changed; without it (a machine that
    # lost its key) the record is republished as it is, and nothing is pinned below
    pub=$(field key "$rec")
    if [ -f "$KEY" ]; then
      own=$(own_pub)
      [ -n "$own" ] || [ -z "$pub" ] || die "can't read the public half of $KEY: restore it with 'ssh-keygen -y -f $KEY > $KEY.pub', then run update again"
    fi
    if [ -n "$own" ] && [ -n "$pub" ] && [ "$pub" != "$own" ]; then
      die "your registry record's key isn't yours ($KEY.pub), so update won't republish it: if someone else changed it, check with your human, then remove $ROOT/agents/$ME.md and its .sig from the store and run register again"
    fi
  fi
  if [ "$cmd" = register ] && [ -z "$nokey" ]; then
    if [ -n "$keyfile" ]; then
      [ -f "$keyfile" ] || die "no such key file $keyfile"
      pub=$(cut -d' ' -f1,2 "$keyfile"); KEY="${keyfile%.pub}"
      [ -f "$KEY" ] || die "the private key ${KEY} (beside $keyfile) is missing"
      [ "$(own_pub)" = "$pub" ] || die "$keyfile isn't the public half of $KEY"
      # written to the config below, once the record is signed with it (a key whose passphrase isn't given leaves
      # the config as it was)
      newkey="$(CDPATH= cd -P -- "$(dirname "$KEY")" && pwd -P)/$(basename "$KEY")"
    elif have_ssh; then
      if [ ! -f "$KEY" ]; then
        mkdir -p "$(dirname "$KEY")" && chmod 700 "$(dirname "$KEY")"
        ssh-keygen -q -t ed25519 -N '' -C "$NS:$ME" -f "$KEY" || die "ssh-keygen failed"
        printf 'generated a signing key at %s (keep the private half on this machine only)\n' "$KEY"
      fi
      pub=$(own_pub)
    else
      require_sigs && die "this store requires signatures, and ssh-keygen (OpenSSH 8.1+) isn't available here"
      warn "ssh-keygen -Y (OpenSSH 8.1+) isn't available: registering without a signing key (mail from you will be unsigned)"
    fi
  fi
  [ -z "$pub" ] || matches "$KEY_RE" "$pub" || die "that doesn't look like an SSH public key"
  if require_sigs && [ -z "$pub" ]; then die "this store requires signatures: register with a key"; fi
  when=$(field registered "$rec" 2>/dev/null); [ -n "$when" ] || when=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  no_link "$rec"; no_link "$M/inbox/$ME/.keep"
  mkdir -p "$M/agents"
  # (human, env and groups are written only when set)
  record_text=$(printf -- '---\nname: %s\nkind: %s\nabout: %s\nruns_on: %s\nwatch: %s\n%s%s%sstatus: %s\nkey: %s\nregistered: %s\n---\n' \
    "$ME" "$kind" "$about" "$runs" "$watchv" "${human:+human: $human
}" "${envw:+env: $envw
}" "${groups:+groups: $groups
}" "$status" "$pub" "$when")
  # update keeps what it doesn't manage (PROTOCOL.md section 2): every other header line, and the text below the
  # header. A field it manages appears once, with its value: a second copy (a key: planted after the agent's own) is
  # dropped, never signed. A record whose header doesn't open and close is written new, as register does
  # (human, env and groups appear only while set: clearing one removes its line)
  if [ "$cmd" = update ] && kept=$(F_name=$ME F_kind=$kind F_about=$about F_runs_on=$runs F_watch=$watchv \
      F_status=$status F_key=$pub F_registered=$when F_human=$human F_env=$envw F_groups=$groups awk '
      BEGIN { split("name kind about runs_on watch status key registered human env groups", k, " ")
              for (i in k) known[k[i]] = 1; opt["human"] = opt["env"] = opt["groups"] = 1 }
      function out(f) { if (!(f in opt) || ENVIRON["F_" f] != "") print f ": " ENVIRON["F_" f] }
      NR == 1 { if ($0 != "---") exit 2; print; next }
      !closed && $0 == "---" { for (i = 1; i <= 11; i++) if (!(k[i] in done)) out(k[i])
                               closed = 1; print; next }
      !closed { f = $0; sub(/:.*/, "", f)
                if ((f in known) && index($0, ":")) { if (!(f in done)) out(f); done[f] = 1; next } }
      { print }
      END { if (!closed) exit 2 }' "$rec"); then record_text=$kept; fi
  paths="$ROOT/agents/$ME.md"
  [ -z "$newkey" ] || one_line key "$newkey"
  if [ -n "$pub" ] && can_sign; then put_signed "$rec" "$record_text" "$pub"; paths="$paths $ROOT/agents/$ME.md.sig"
  else put "$rec" "$record_text"; fi
  # (newkey is set only by register, which has refused a record that's there: the one just written is removed)
  [ -z "$newkey" ] || ( set_cfg key "$newkey" ) ||
    { rm -f "$rec" "$rec.sig"; die "$CONFIG couldn't be updated with the key, so nothing was registered: fix that, then run register again"; }
  mkdir -p "$M/inbox/$ME"; [ -f "$M/inbox/$ME/.keep" ] || { new_keep "$M/inbox/$ME/.keep"; paths="$paths $ROOT/inbox/$ME/.keep"; }
  # shellcheck disable=SC2086
  AD_UNCHANGED=; ad_commit "mailbox: $ME ${cmd}s" $paths
  # (the record and its signature are always written again, so a stale or missing one is replaced; when they come out
  # as they were, the adapter publishes nothing and says so, and so does update, below)
  unchanged=""; [ "$cmd" != update ] || unchanged=${AD_UNCHANGED:-}
  # a retired agent has no watcher to keep armed: drop this session's marker, so a harness hook stops asking for one
  if [ "$status" = retired ] && [ -n "$SESSION" ]; then
    [ "$(session_name)" != "$ME" ] || rm -f "$STATE/sessions/$SESSION" "$STATE/session-configs/$SESSION"
    session_store - 2>/dev/null || true
  fi
  # pin your own name only to a key you hold
  [ -z "$pub" ] || { [ "$cmd" = update ] && [ -z "$own" ]; } || { mkdir -p "$STATE/pins/$STORE_ID"; printf '%s\n' "$pub" | sha > "$STATE/pins/$STORE_ID/$ME"; }
  if [ -n "$unchanged" ] && [ -n "$AD_PUBLISHED" ]; then echo "update: nothing new to update for $ME ($status): the earlier change is now published"
  elif [ -n "$unchanged" ]; then echo "update: nothing to update for $ME ($status)"
  else echo "$cmd: $ME ($status)${pub:+, signing key $(printf '%s' "$pub" | cut -c1-24)...}"; fi ;;
agents)
  # filters: each given must match (a --group each, for several); a field that isn't well formed matches none
  fh="" fe="" fg="" names="" seen=""
  while [ $# -gt 0 ]; do
    case "$1" in --names) names=1; shift; continue ;; --human|--env|--group) ;; *) misplaced "$1"; unknown "$1" ;; esac
    [ $# -ge 2 ] || die "$1 needs a value"
    # (each value is one name: one with spaces or a pattern would be split or expanded below)
    matches "$NAME_RE" "$2" || die "$1 takes one name (lowercase a-z, 0-9, '.', '-'; up to 63), not '$2'"
    case "$1" in --human) once "$1"; fh=$2 ;; --env) once "$1"; fe=$2 ;; --group) fg="$fg $2" ;; esac; shift 2
  done
  load_adapter; ad_sync; need_store
  [ -n "$names" ] || printf '%-24s %-8s %-10s %-4s %-16s %-8s %-24s %s\n' NAME STATUS KIND KEY HUMAN ENV GROUPS ABOUT; fps=
  for r in "$M"/agents/*.md; do
    [ -f "$r" ] || continue
    n=$(basename "$r" .md); matches "$NAME_RE" "$n" || continue
    h=$(claim human "$r"); e=$(claim env "$r"); g=$(claim groups "$r")
    [ -z "$fh" ] || [ "$h" = "$fh" ] || continue
    [ -z "$fe" ] || [ "$e" = "$fe" ] || continue
    miss=""; for x in $fg; do case " $g " in (*" $x "*) ;; (*) miss=1 ;; esac; done; [ -z "$miss" ] || continue
    # (--names: each active agent whose record names it, one per line, ready for a loop that sends to each)
    if [ -n "$names" ]; then [ "$(field name "$r")" = "$n" ] && [ "$(field status "$r")" = active ] && echo "$n"; continue; fi
    k=no; rk=$(reg_key "$r") && k=yes
    [ "$(field name "$r")" = "$n" ] || n="$n(!name)"
    [ -z "$rk" ] || { fp=$(fpnote "$rk"); [ -z "$fp" ] || fps="$fps$(printf '%-24s %s' "$n" "$fp")$NL"; }
    # the record's status, kind and about are escaped and cut to 200 bytes each, so no record can draw rows; human, env
    # and groups are names only (or -)
    printf '%s\n%s\n%s\n' "$(field status "$r")" "$(field kind "$r")" "$(field about "$r")" | clean "$CAP" |
      { IFS= read -r s; IFS= read -r kd; IFS= read -r ab
        printf '%-24s %-8s %-10s %-4s %-16s %-8s %-24s %s\n' "$n" "$s" "$kd" "$k" "${h:--}" "${e:--}" "$(printf '%s' "${g:--}" | tr ' ' ,)" "$ab"; }
  done
  [ -z "$names" ] || exit 0
  # each key's fingerprint, to compare with its agent's human out of band (`trust` prints the one it pins)
  [ -z "$fps" ] || printf '\nkey fingerprints:\n%s' "$fps" ;;
trust)
  for a in "$@"; do misplaced "$a"; done; [ $# -eq 1 ] || die "usage: trust <name> | trust --relax"
  if [ "$1" = --relax ]; then load_adapter; rm -f "$STATE/pins/$STORE_ID/.strict"
    echo "this store is strict for you only while its store.md requires signatures"; exit 0; fi
  valid_name "$1"; load_adapter; ad_sync
  pub=$(reg_key "$(record "$1")"); [ -n "$pub" ] || die "'$1' has no registered key"
  mkdir -p "$STATE/pins/$STORE_ID"; printf '%s\n' "$pub" | sha > "$STATE/pins/$STORE_ID/$1"
  fp=$(fpnote "$pub")
  # in a strict store, what the old key signed stops counting; elsewhere it reads bad, and its holds still count
  if [ -f "$M/store.md" ] && require_sigs; then
    echo "pinned $1's current key${fp:+ ($fp)}; mail $1 signed with an earlier key (holds included) no longer counts"
  else
    echo "pinned $1's current key${fp:+ ($fp)}; mail $1 signed with an earlier key now reads bad, and its holds still count, since this store doesn't require signatures"
  fi ;;
send)
  [ $# -ge 3 ] || die "usage: send <to> <topic> <body.md|-> [--context c] [--in-reply-to file] [--needs text] [--consume file]... [--hold|--release \"<item> <version>\"]"
  to=$1 topic=$2 body=$3; shift 3
  context="" ctx_set="" reply="" needs=none consume="" hold="" release="" seen=""
  while [ $# -gt 0 ]; do
    misplaced "$1"; [ $# -ge 2 ] || die "$1 needs a value"
    case "$1" in (--consume) ;; (--hold|--release) once "$1" "a message carries one hold or release; send one message per item" ;;
      (*) once "$1" ;; esac
    case "$1" in
      --context) context=$2; ctx_set=1 ;; --in-reply-to) reply=$(basename -- "$2") ;; --needs) needs=$2 ;;
      --consume) consume="$consume $(basename -- "$2")" ;; --hold) hold=$2 ;; --release) release=$2 ;;
      *) unknown "$1" ;;
    esac; shift 2
  done
  need_me; valid_name "$to"
  [ -n "$reply" ] || reply=$(echo $consume | cut -d' ' -f1); [ -n "$reply" ] || reply=none
  [ -n "$hold" ] && [ -n "$release" ] && die "a message records a hold or a release, not both"
  for h in "$hold" "$release"; do [ -z "$h" ] || matches "$ITEM_RE" "$h" || die "a hold or release is \"<item> <version>\", not '$h'"; done
  for v in context:"$context" topic:"$topic" in_reply_to:"$reply" needs:"$needs" hold:"$hold" release:"$release"; do one_line "${v%%:*}" "${v#*:}"; done
  matches "$NAME_RE" "$topic" || die "topic must be lowercase a-z, 0-9, '.' or '-'"
  [ -z "$ctx_set" ] || matches "$NAME_RE" "$context" || die "context must be lowercase a-z, 0-9, '.' or '-'"
  [ "$body" = - ] && body=/dev/stdin
  [ "$body" = /dev/stdin ] || [ -f "$body" ] || die "the body must be a file path, or - for stdin"
  # a closed stdin is refused before anything reads it: $(cat) below would open its pipe as fd 0, and bash leaves that
  # in cat, which then reads its own output and waits forever. Copying fd 0 elsewhere fails when it's closed (in dash
  # and bash, `<&0` alone never does); it's on true, not :, since a failed redirection on : ends sh
  [ "$body" != /dev/stdin ] || { true 9<&0; } 2>/dev/null ||
    die "can't read the body from stdin: it's closed (pipe the body in, or pass a file path)"
  # never mail out an SSH key, this CLI's config, state or key, or any private key, whoever asked (ceiling: secret_file)
  if secret_file "$body"; then
    # the state folder also holds the git adapter's copy of the store, so a message received there is refused too
    h=""; [ "$SF" = "$STATE" ] && case $(real "$body") in (*/checkouts/*/"$ROOT"/inbox/*/*.md) true ;; (*) false ;; esac &&
      h="; to forward a message, copy its text into a new file first"
    w="this CLI's config file or signing key"; [ -z "$SF" ] || w="in $SF"
    [ "$SF" != - ] || w="a path whose links can't be followed to the end"
    case $SF in ("!"*) w="unchecked: ${SF#!} holds a link whose path has a line break (rename it)" ;; esac
    die "refusing to send $body: it's $w$h (never put secrets in mail)"
  fi
  # stdin itself is read as fd 0, not reopened by name, so a socket works and a write-only stdin isn't read from its file
  if [ "$body" = /dev/stdin ]; then text=$(cat) || die "can't read stdin"
  else text=$(cat -- "$body") || die "can't read $body"; fi
  [ -n "$text" ] || die "empty message body"
  ! printf '%s\n' "$text" | LC_ALL=C grep -Eq -- "$PRIVKEY_RE" ||
    die "refusing to send: the body holds a private key's text (a line of its block; never put secrets in mail; to discuss a key, describe it, or send its public half)"
  [ -n "$LOADED" ] || { load_adapter; ad_sync; need_store; }
  active "$to" || die "'$to' isn't an active agent in this mailbox"
  need_active_me
  # sign only with the key your registry record names, so what you send verifies; a strict store refuses otherwise
  cs=""; can_sign && cs=1; rk=$(reg_key "$(record "$ME")"); mine=""; [ -z "$cs" ] || mine=$(own_pub); signer=""
  [ -n "$cs" ] && [ -n "$rk" ] && [ "$rk" = "$mine" ] && signer=1
  if require_sigs && [ -z "$signer" ]; then [ -n "$cs" ] || die "this store requires signatures, and no usable key is at $KEY"
    [ -n "$rk" ] || die "this store requires signatures, and your registry record ($ROOT/agents/$ME.md) names no usable key"
    matches "$KEY_RE" "$mine" || die "can't read the public half of $KEY: restore it with 'ssh-keygen -y -f $KEY > $KEY.pub', then send again"
    die "this store requires signatures, and your registry record's key isn't the one at $KEY"; fi
  # removals go through your own inbox folder, never a link to elsewhere (a link inside it is removed as a link)
  [ -z "$consume" ] || no_link "$M/inbox/$ME"
  for c in $consume; do valid_msg "$c"
    [ -f "$M/inbox/$ME/$c" ] || die "not in your inbox: $c"; done
  # a reply keeps the thread's context (PROTOCOL.md section 5), read from the message it answers while that's still
  # in your inbox; otherwise, and for a value that isn't a valid context, it's "general"
  if [ -z "$ctx_set" ] && matches "$MSG_RE" "$reply" && [ -f "$M/inbox/$ME/$reply" ] && [ ! -L "$M/inbox/$ME/$reply" ]; then
    context=$(field context "$M/inbox/$ME/$reply"); matches "$NAME_RE" "$context" || context=""
  fi
  context="${context:-general}"
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  # this sender never reuses a file name it used (PROTOCOL.md section 5), even once the message it named is consumed: a
  # send waits for the next second when this sender already used the same name for the same recipient in this second.
  # The record holds the second, then each <to>/<name> used in it. It's advisory: a send whose record can't be read or
  # written warns, and goes ahead.
  # ceiling: it knows this sender's sends from this state folder, in an equal second; not a clock set back, and not
  # another sender whose name and topic join to the same file name (alice with topic x-y, alice-x with topic y)
  used="$STATE/names/$STORE_ID/$ME"
  while { IFS= read -r us < "$used"; } 2>/dev/null && [ "$us" = "$stamp" ] &&
    grep -qxF -- "$to/$stamp-$ME-$topic.md" "$used"; do sleep 1; stamp=$(date -u +%Y%m%dT%H%M%SZ); done
  # a name the store already has (another sender's whose name and topic join to it, or one this clone's leftover was
  # moved to) gets the next second, once; a name taken then too stops the send, below
  { [ -e "$M/inbox/$to/$stamp-$ME-$topic.md" ] || [ -L "$M/inbox/$to/$stamp-$ME-$topic.md" ]; } && { sleep 1; stamp=$(date -u +%Y%m%dT%H%M%SZ); }
  # holds orders one sender's records by their sent time, to the second, and on a tie a hold beats a release: a hold
  # or release waits for the next second after this sender's previous one in this store, so the two never tie.
  # ceiling: it knows only this machine's sends (a name has one live session) and an equal second, not a clock set
  # back; reading the sender's latest record from the store's history would cover both
  if [ -n "$hold$release" ]; then
    last="$STATE/gates/$STORE_ID/$ME"
    while [ "$(cat "$last" 2>/dev/null)" = "$stamp" ]; do sleep 1; stamp=$(date -u +%Y%m%dT%H%M%SZ); done
    mkdir -p "$STATE/gates/$STORE_ID" && printf '%s\n' "$stamp" > "$last" || die "can't write $last"
  fi
  { mkdir -p "$STATE/names/$STORE_ID" &&
    if { IFS= read -r us < "$used"; } 2>/dev/null && [ "$us" = "$stamp" ]; then
      printf '%s\n' "$to/$stamp-$ME-$topic.md" >> "$used"
    else printf '%s\n%s\n' "$stamp" "$to/$stamp-$ME-$topic.md" > "$used"; fi; } 2>/dev/null ||
    warn "can't record this send's file name in $used, so a send in the same second may reuse it; sending anyway"
  f="$M/inbox/$to/$stamp-$ME-$topic.md"
  { [ -e "$f" ] || [ -L "$f" ]; } && die "$(rel "$f") exists (one message per topic per second)"
  no_link "$f"; no_link "$M/inbox/$to/.keep"; [ -d "$M/inbox/$to" ] || [ ! -e "$M/inbox/$to" ] || die "$(rel "$M/inbox/$to") isn't a folder"
  mkdir -p "$M/inbox/$to"; paths=""
  [ -f "$M/inbox/$to/.keep" ] || { new_keep "$M/inbox/$to/.keep"; paths="$ROOT/inbox/$to/.keep"; }
  msg=$(printf -- '---\nprotocol: %s\nfrom: %s\nto: %s\ntopic: %s\ncontext: %s\nsent: %s\nin_reply_to: %s\nneeds: %s\n%s%s---\n\n%s\n' \
    "$PROTOCOL" "$ME" "$to" "$topic" "$context" "$(stamp_iso "$stamp")" "$reply" "$needs" \
    "${hold:+hold: $hold
}" "${release:+release: $release
}" "$text")
  PUT_NEW=1
  if [ -n "$signer" ]; then put_signed "$f" "$msg" "$rk"; paths="$paths $(rel "$f") $(rel "$f").sig"
  else warn "sending unsigned (no key at $KEY, no ssh-keygen -Y (OpenSSH 8.1+), its public half unreadable, or your registry record names no key or another one)"; put "$f" "$msg"; paths="$paths $(rel "$f")"; fi
  PUT_NEW=""
  for c in $consume; do rm -f "$M/inbox/$ME/$c" "$M/inbox/$ME/$c.sig"; paths="$paths $ROOT/inbox/$ME/$c $ROOT/inbox/$ME/$c.sig"; done
  # shellcheck disable=SC2086
  ad_commit "mail(to-$to): $topic" $paths
  echo "sent $(rel "$f")" ;;
list)
  [ $# -eq 0 ] || unknown "$1"
  need_me; load_adapter; ad_sync; need_store
  mail=$(inbox_files "$ME"); [ -n "$mail" ] || no_mail
  printf '%s\n' "$mail" | while IFS= read -r p; do rel "$p"; done | clean ;;
sent)
  for a in "$@"; do case "$a" in (-*) unknown "$a" ;; esac; done
  [ $# -le 1 ] || die "usage: sent [<to>]"
  [ $# -eq 0 ] || valid_name "$1"; to=${1:-}
  need_me; load_adapter; ad_sync; need_store
  # mail from you is a message whose file name's sender field and from: header both name you, so another writer's
  # file can't pass by one alone. Signatures aren't checked: a writer could plant both. Rows: <id> <path> <to> <sent>
  # <needs>, sorted by id (time first), with sent as "?" when it isn't the form send writes
  rows=$(for d in "$M"/inbox/*; do r=${d##*/}
      [ -z "$to" ] || [ "$r" = "$to" ] || continue
      [ -d "$d" ] && matches "$NAME_RE" "$r" || continue
      inbox_files "$r" | while IFS= read -r p; do b=${p##*/}
        case "$b" in (????????T??????Z-"$ME"-?*) ;; (*) continue ;; esac
        [ "$(field from "$p")" = "$ME" ] || continue
        s=$(field sent "$p"); matches "$SENT_RE" "$s" || s="?"
        printf '%s %s %s %s %s\n' "$b" "$(rel "$p")" "$r" "$s" "$(field needs "$p" | LC_ALL=C sed "$CAP")"
      done
    done | LC_ALL=C sort)
  [ -n "$rows" ] || { echo "no mail from $ME waiting${to:+ for $to}"; exit 3; }
  # age from sent to now, both UTC, by days from the civil date (no date -d, which BSD date lacks)
  printf '%s\n' "$rows" | LC_ALL=C awk -v now="$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    function ok(s,  y, m, d, n) { y = substr(s, 1, 4) + 0; m = substr(s, 6, 2) + 0; d = substr(s, 9, 2) + 0
      n = m == 2 ? (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) ? 29 : 28) : (m == 4 || m == 6 || m == 9 || m == 11 ? 30 : 31)
      return m >= 1 && m <= 12 && d >= 1 && d <= n && substr(s, 12, 2) + 0 <= 23 && substr(s, 15, 2) + 0 <= 59 && substr(s, 18, 2) + 0 <= 60 }
    function t(s,  y, m, e, d) { y = substr(s, 1, 4) + 0; m = substr(s, 6, 2) + 0; if (m <= 2) y--; e = y % 400
      d = int(y / 400) * 146097 + e * 365 + int(e / 4) - int(e / 100) + int((153 * ((m + 9) % 12) + 2) / 5) + substr(s, 9, 2) - 719469
      return d * 86400 + substr(s, 12, 2) * 3600 + substr(s, 15, 2) * 60 + substr(s, 18, 2) }
    { n = $0; sub(/^[^ ]* [^ ]* [^ ]* [^ ]* ?/, "", n); a = $4 == "?" || !ok($4) ? -1 : t(now) - t($4)
      # a sent time ahead of now (a skewed clock, or a planted file) shows "?", allowing a minute of skew
      if (a < 0 && a >= -60 && ok($4)) a = 0
      g = a < 0 ? "?" : a < 60 ? a "s" : a < 3600 ? int(a / 60) "m" : a < 86400 ? int(a / 3600) "h" : int(a / 86400) "d" int(a % 86400 / 3600) "h"
      print $2 " to " $3 " age " g (a > 86400 ? " stale" : "") (n != "" && n != "none" ? " needs: " n : "") }' | clean ;;
read)
  except=""
  while [ $# -gt 0 ]; do
    case "$1" in --except) [ $# -ge 2 ] || die "--except needs a file"; except="$except $(basename -- "$2")"; shift 2 ;;
                 *) unknown "$1" ;; esac
  done
  need_me; load_adapter; ad_sync; need_store
  # each message is read once, into a private copy (with its .sig), and verified, read and shown from that copy, so a
  # file swapped in the store meanwhile can't be shown under another's status
  rt="$STATE/tmp.read.$$"; mkdir -p "$rt" || die "can't create $rt"
  shown=$(inbox_files "$ME" | while IFS= read -r p; do
    case " $except " in (*" $(basename "$p") "*) continue ;; esac
    cat -- "$p" > "$rt/m" 2>/dev/null || continue
    if [ -f "$p.sig" ] && [ ! -L "$p.sig" ]; then cat -- "$p.sig" > "$rt/m.sig" 2>/dev/null || rm -f "$rt/m.sig"; else rm -f "$rt/m.sig"; fi
    v=$(verify_file "$rt/m" "$ME")
    # a verified message names who signed it; and the header, not the file name, says who sent a message, so a file
    # name other than <stamp>-<from>-<topic>.md is pointed out (names may hold '-', so which part is off can't always
    # be told: the note says what the name should be)
    fr=$(field from "$rt/m"); tp=$(field topic "$rt/m"); b=${p##*/}
    st='[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z'
    if matches "$NAME_RE" "$fr"; then
      [ "$v" != verified ] || v="verified: from $fr"
      if matches "$NAME_RE" "$tp"; then case "$b" in ($st-"$fr-$tp".md) ;; (*) v="$v; its file name doesn't name it as from $fr about $tp" ;; esac
      else case "$b" in ($st-"$fr"-*) ;; (*) v="$v; its file name doesn't name $fr as the sender" ;; esac; fi
    fi
    printf '===== %s [%s]\n' "$(rel "$p")" "$v"
    # a body line can't pass for a boundary: a line whose first = comes after nothing but non-printing characters (no
    # printable ASCII: tabs, other controls and non-ASCII bytes all count, so no invisible character can hide what comes
    # first) is indented; a last line without its newline gets one, and each message ends with its own marker
    clean 's/^[^ -~]*=/ &/' < "$rt/m"; [ -z "$(tail -c 1 < "$rt/m" | tr '\000' x)" ] || echo; printf '===== end %s\n\n' "$(rel "$p")"
  done)
  rm -rf "$rt"
  [ -n "$shown" ] || no_mail
  printf '%s\n' "$shown" ;;
consume)
  # an argument starting with '-' is a name when it's a message file name, and every argument after the first -- is one
  na=$# e=""; for a in "$@"; do
    if [ -z "$e" ]; then case "$a" in (--) e=1; continue ;; (-*) matches "$MSG_RE" "$a" || unknown "$a" ;; esac; fi; set -- "$@" "$a"
  done; shift "$na"
  [ $# -ge 1 ] || die "usage: consume [--] <file>..."
  need_me; load_adapter; ad_sync; need_store
  paths=""; no_link "$M/inbox/$ME"
  for a in "$@"; do
    b=$(basename -- "$a"); [ "$b" = .keep ] && die "an inbox's .keep is never consumed"
    valid_msg "$b"
    [ -f "$M/inbox/$ME/$b" ] || die "not in your inbox: $b"; paths="$paths $ROOT/inbox/$ME/$b $ROOT/inbox/$ME/$b.sig"
  done
  for a in "$@"; do b=$(basename -- "$a"); rm -f "$M/inbox/$ME/$b" "$M/inbox/$ME/$b.sig"; done
  # shellcheck disable=SC2086
  ad_commit "mail(to-$ME): consumed $(for a in "$@"; do basename -- "$a" .md; done | tr '\n' ' ')" $paths
  echo "consumed" ;;
verify)
  for a in "$@"; do misplaced "$a"; done; [ $# -eq 1 ] || die "usage: verify <file>"; load_adapter; ad_sync
  # by path, by path in the store, or by message file name in your own inbox (a name only, never a pattern)
  # (by name it's checked as mail to you, so a copy addressed to someone else reads misrouted, as in read)
  f=$1 inb=""; [ -f "$f" ] || f="$AD_DIR/$1"
  if [ ! -f "$f" ]; then b=$(basename -- "$1"); f=""; matches "$MSG_RE" "$b" && { need_me; f="$M/inbox/$ME/$b" inb=$ME; }; fi
  [ -n "$f" ] && [ -f "$f" ] || die "no such message $1"
  # by path, a message sitting in an inbox is checked against that inbox, so a misrouted copy reads misrouted there too
  if [ -z "$inb" ] && d=$(phys "$(dirname -- "$f")") && [ "$(dirname -- "$d")" = "$(phys "$M/inbox")" ]; then inb=$(basename -- "$d"); fi
  v=$(verify_file "$f" "$inb"); echo "$v"; [ "$v" = verified ] || exit 6 ;;
holds)
  item="" version="" seen=""
  while [ $# -gt 0 ]; do
    case "$1" in --version) [ $# -ge 2 ] || die "--version needs a value"; once "$1"; version=$2; shift 2 ;;
                 -*) unknown "$1" ;; *) [ -z "$item" ] || die "holds takes one item, not '$item' and '$1'"; item=$1; shift ;; esac
  done
  need_me; [ -z "$version" ] || [ -n "$item" ] || die "--version needs an item"
  load_adapter; ad_sync; need_store
  strict=""; require_sigs && strict=1
  tmpd="$STATE/tmp.holds.$$"; mkdir -p "$tmpd" || die "can't create $tmpd"
  # every message ever delivered to you that may carry a hold or release, in delivery order (consumed mail
  # included): <ref> <path>. The pattern lets an adapter skip the rest; each record is still checked below. Files in
  # a subfolder of the inbox aren't messages (PROTOCOL.md section 2), as for read and list.
  records=$(ad_history "$ROOT/inbox/$ME" '^(hold|release):' | while IFS= read -r p; do ref=${p%% *} p=${p#* }
      [ "$ref" != '!' ] || { echo '!'; continue; }
      case "$p" in (*.md) ;; (*) continue ;; esac
      case "${p#"$ROOT/inbox/$ME/"}" in (*/*) continue ;; esac
      # a listed version it can't read stops holds, like a history it can't read
      ad_show "$ref" "$p" > "$tmpd/m" 2>/dev/null || { echo '!'; continue; }
      ad_show "$ref" "$p.sig" > "$tmpd/m.sig" 2>/dev/null || rm -f "$tmpd/m.sig"
      kind=hold; rec=$(field hold "$tmpd/m"); [ -n "$rec" ] || { kind=release; rec=$(field release "$tmpd/m"); }
      [ -n "$rec" ] || continue
      basename "$p" | grep -Eq '^[A-Za-z0-9._-]+\.md$' || continue
      from=$(field from "$tmpd/m"); sent=$(field sent "$tmpd/m")
      # every column of the row below is validated, so no header value can shift the others (PROTOCOL.md section 5). A
      # sender that isn't a name can't be named as the signer, and an item whose first word isn't an item names none:
      # neither counts. An item with more after its first word is read under that word, and a sent in another form
      # (-) in delivery order (below); either is read like a header that isn't plain
      matches "$NAME_RE" "$from" || continue
      odd=""; matches "$ITEM_RE" "$rec" || { i=${rec%% *}; matches '^[A-Za-z0-9._/#:@-]{1,200}$' "$i" || continue; rec="$i ?" odd=1; }
      matches "$SENT_RE" "$sent" || { sent=- odd=1; }
      # a record whose header isn't plain, or that doesn't parse, blocks the gate (as a conflict does) when its signature
      # checks out (verified, or a pinned sender's changed or missing key): what it means can't be read for sure. One
      # whose signature doesn't reads bad
      v=$(verify_sig "$tmpd/m" "$ME")
      if [ -n "$odd" ] || ! hdr_ok "$tmpd/m"; then
        case "$v" in (verified|changed) kind=malformed ;;
          (nokey) if [ -f "$STATE/pins/$STORE_ID/$from" ]; then kind=malformed; else v=bad; fi ;;
          (*) v=bad ;; esac
        # (an item with more after it names no version, so it never counts as the hold or release it seems to be)
        case "$rec" in (*" ?") kind=malformed ;; esac
      fi
      # in a strict store, only verified records count, except that a hold, or a record whose header isn't plain, whose
      # sender's key changed, or vanished after this reader pinned it, still blocks: dropping it would let a registry
      # edit open the gate. unsigned and bad
      # never count, and nokey counts only for a pinned sender, so no hold planted under a name this reader never
      # verified counts. It clears when the key is restored, or trusted after checking with the sender's human
      [ -z "$strict" ] || [ "$v" = verified ] || { { [ "$kind" = hold ] || [ "$kind" = malformed ]; } && { [ "$v" = changed ] ||
        { [ "$v" = nokey ] && [ -f "$STATE/pins/$STORE_ID/$from" ]; }; }; } || continue
      echo "$sent $kind $rec $from $(basename "$p") $v"
    done)
  rm -rf "$tmpd"
  case "$NL$records$NL" in (*"$NL!$NL"*) die "can't read this store's full, latest history (check that the store is reachable), so holds can't decide" ;; esac
  # an adapter that doesn't keep every version (or doesn't say) lists only current mail: say so, then decide as usual,
  # since a store without history is a choice (adapters/README.md)
  if [ "$AD_HISTORY" != full ]; then
    if [ -z "$AD_HISTORY" ]; then h="doesn't say whether it keeps history"; else h="keeps no history"; fi
    echo "holds: warning: the $ADAPTER adapter $h, so a hold or release that was consumed or deleted isn't seen; gate real actions with an adapter that keeps history (git)" >&2
  fi
  # items and versions are compared as text throughout, never as numbers (awk's ($x "") forces a string comparison),
  # and reach awk through the environment, which, unlike -v, takes them as they are, backslashes included
  [ -z "$item" ] || records=$(echo "$records" | HOLDS_ITEM=$item awk '($3 "") == (ENVIRON["HOLDS_ITEM"] "")')
  # the latest record per item and sender, in delivery order; a record whose (signed) sent time is older than one
  # already seen from that sender for that item is a replay and is ignored. A store writer controls history order, so
  # order mustn't decide between records with an equal sent time: a hold wins, a record whose header isn't plain
  # blocks, and two releases naming different versions conflict (neither counts). A record whose sent isn't in its
  # one form (-) takes the time of the one before it from that sender for that item, in delivery order, so it counts
  # as of then, until that sender's next record
  latest=$(echo "$records" | awk 'NF { k = $3 " " $5; s = $1; if (s == "-") s = (k in t) ? t[k] : ""
      if (!(k in t) || s > t[k]) { t[k] = s; kind[k] = $2; v[k] = $4; last[k] = $0; next }
      if (s < t[k] || kind[k] == "hold") next
      if ($2 == "hold") { kind[k] = "hold"; v[k] = $4; last[k] = $0; next }
      if ($2 == "malformed") { kind[k] = "malformed"; last[k] = $0; next }
      if (kind[k] == "malformed") next
      if (kind[k] == "release" && ($4 "") != (v[k] "")) { kind[k] = "conflict"; last[k] = $1 " conflict " $3 " " v[k] "," $4 " " $5 " " $6 " " $7 } }
    END { for (k in last) print last[k] }' | sort -k3,3 -k1,1)
  if [ -z "$version" ]; then
    [ -n "$latest" ] && echo "$latest" || echo "no holds or releases recorded in mail to $ME${item:+ for $item}"
    exit 0
  fi
  [ -n "$latest" ] || { echo "holds: nothing recorded for $item"; exit 5; }
  # (a record that blocks says why: a sent of another form is listed as -, and an item with more after it as <item> ?;
  # otherwise its header isn't plain)
  echo "$latest" | HOLDS_WANT=$version HOLDS_STRICT=$strict awk 'function why() {
      if ($1 == "-" && $4 == "?") return "whose sent: and hold: or release: lines don'"'"'t parse"
      if ($1 == "-") return "whose sent: time doesn'"'"'t parse"
      if ($4 == "?") return "whose hold: or release: line doesn'"'"'t parse"
      return "whose header isn'"'"'t plain" }
    BEGIN { want = ENVIRON["HOLDS_WANT"]
      oldkey = ENVIRON["HOLDS_STRICT"] != "" ? "mail signed with its old key, holds included, then stops counting" : "its old key'"'"'s holds still count after that, since this store doesn'"'"'t require signatures: ask it to release them" }
    $2 == "hold" && ($7 == "changed" || $7 == "nokey") { print "holds: " $3 " is held by " $5 " at " $4 " (" $6 ", " $7 ": confirm " $5 "'"'"'s new key (or restored record) with its human out of band" ($7 == "changed" ? " (`agents` shows its fingerprint)" : "") " and ask " $5 " to re-send any hold it still means, then trust " $5 " (" oldkey "), or restore its record)"; bad = 1; next }
    $2 == "hold" { print "holds: " $3 " is held by " $5 " at " $4 " (" $6 ")"; bad = 1; next }
    $2 == "malformed" && ($7 == "changed" || $7 == "nokey") { print "holds: " $3 " has a record from " $5 " " why() " (" $6 ", " $7 ": confirm " $5 "'"'"'s new key (or restored record) with its human out of band" ($7 == "changed" ? " (`agents` shows its fingerprint)" : "") " and ask " $5 " to re-send any hold it still means, then trust " $5 " (" oldkey "), or restore its record)"; bad = 1; next }
    $2 == "malformed" { print "holds: " $3 " has a record from " $5 " " why() " (" $6 "); ask " $5 " to send it again"; bad = 1; next }
    $2 == "conflict" { print "holds: " $3 " has releases from " $5 " sent at the same time for different versions (" $4 "); ask " $5 " to send one release again"; bad = 1; next }
    ($4 "") != (want "") { print "holds: " $3 " was released by " $5 " at " $4 ", not " want " (" $6 ")"; bad = 1; next }
    { print "holds: " $3 " released by " $5 " at " $4 " (" $6 ", " $7 ")"; if ($7 != "verified") weak = 1 }
    END { if (!bad && weak) print "holds: warning: a deciding release isn'"'"'t signature-verified; only a store with require_signatures: true stops forged releases, and only a branch protected against force-pushes and deletion keeps a hold from being erased" > "/dev/stderr"
          exit bad ? 5 : 0 }' ;;
watch)
  interval=120 max=7000 except="" pos=0 also=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --except) [ $# -ge 2 ] || die "--except needs a file"; except="$except $(basename -- "$2")"; shift 2 ;;
      --also) also=1; shift ;;
      -*) unknown "$1" ;;
      *) pos=$((pos+1)); [ $pos -le 2 ] || die "watch takes an interval and a max, not '$1' too"
         [ $pos -eq 1 ] && interval=$1; [ $pos -eq 2 ] && max=$1; shift ;;
    esac
  done
  need_me
  case "$interval" in ''|*[!0-9]*) die "the interval must be whole seconds" ;; esac
  case "$max" in ''|*[!0-9]*) die "max must be whole seconds (0 for no limit)" ;; esac
  [ "$interval" -ge 1 ] && [ ${#interval} -le 6 ] && [ ${#max} -le 9 ] || die "the interval or max is out of range"
  load_adapter; ad_sync; need_store
  need_active_me
  # (the watch itself only peeks and polls, which leave the clone alone, so other commands under this name go ahead;
  # an adapter from before ad_unlock has none)
  ! command -v ad_unlock >/dev/null 2>&1 || ad_unlock
  # the session marker lets `send` find your name in shells without exports; the pid file lets a harness hook check
  # that this watcher is alive (hooks/claude-watch-guard.sh). The config path, made physical as the key's is (or just
  # absolute, if its folder can't be reached), goes in a folder of its own (session-configs/), so that hook's re-arm
  # command uses this config, an older reader still finds the name, and no session id names another's record.
  # ceiling: $(...) drops a trailing newline from a folder or file name in that path; the re-arm then fails, or names
  # the one without the newline
  mkdir -p "$STATE/run" "$STATE/sessions" "$STATE/session-configs"
  if [ -n "$SESSION" ]; then
    if d=$(CDPATH= cd -P -- "$(dirname -- "$CONFIG")" 2>/dev/null && pwd -P); then c="${d%/}/$(basename -- "$CONFIG")"
    else case "$CONFIG" in (/*) c=$CONFIG ;; (*) c="$(pwd)/$CONFIG" ;; esac; fi
    printf '%s\n' "$c" > "$STATE/session-configs/$SESSION"
    echo "$ME" > "$STATE/sessions/$SESSION"
    session_store "$c" "$also"
  fi
  # a second watcher for the name on this store, from this state folder, wakes on the same mail as the first: say so,
  # once, and carry on, taking the pid files over as before (a refusal could leave a session that nothing wakes). A live
  # watcher is one whose pid file names this store and a running process whose command line is an agent-mailbox watch
  # (other_watcher), so a stale file, a dead pid or one reused by another process doesn't count
  for pf in "$STATE/run/$ME@$STORE_ID.pid" "$STATE/run/$ME.pid"; do
    wp=$(other_watcher "$pf") || continue
    warn "watch: another watcher for $ME is running (pid $wp); both wake on the same mail: stop this one, or pid $wp unless the Claude Code plugin's hook started it (its parent is claude-rewake.sh; the hook would start it again)"; break
  done
  # (one for the name, and one for the name on this store, since one name can be in use on several stores)
  for pf in "$STATE/run/$ME.pid" "$STATE/run/$ME@$STORE_ID.pid"; do echo "$$ $ME $STORE_ID" > "$pf"; done
  # (removed only while it still names this watcher: another watcher for the name may have started since)
  unmark() { for pf in "$STATE/run/$ME.pid" "$STATE/run/$ME@$STORE_ID.pid"; do
    [ "$(cut -d' ' -f1 "$pf" 2>/dev/null)" != $$ ] || rm -f "$pf"; done; }
  trap unmark EXIT
  trap 'exit 130' INT TERM
  # a failed peek fails the check (a pipe would report only the loop's status), so it's retried, never read as "no mail"
  check() { files=$(ad_peek "$ROOT/inbox/$ME") || return 1
            printf '%s\n' "$files" | while IFS= read -r p; do
              b=$(basename "$p"); matches "$MSG_RE" "$b" || continue
              case " $except " in (*" $b "*) ;; (*) echo "$p" ;; esac; done; }
  last=$(ad_poll 2>/dev/null) || last=""
  if mail=$(check); then [ -z "$mail" ] || { echo "mail for $ME:"; printf '%s\n' "$mail" | clean; exit 0; }; else last=""; fi
  # a store it can't reach or read ends the watch loudly after 10 failures in a row, so the agent wakes and sees why
  start=$(date +%s); fails=0
  while [ "$max" -eq 0 ] || [ $(( $(date +%s) - start )) -lt "$max" ]; do
    sleep "$interval"
    if now=$(ad_poll 2>/dev/null) && [ -n "$now" ]; then :; else
      fails=$((fails+1)); [ "$fails" -lt 10 ] && continue; die "watch: can't reach the store ($fails tries in a row)"
    fi
    [ "$now" != "$last" ] || { fails=0; continue; }
    if ! mail=$(check); then fails=$((fails+1)); [ "$fails" -lt 10 ] && continue; die "watch: can't read the store ($fails tries in a row)"; fi
    fails=0; last=$now
    [ -n "$mail" ] && { echo "mail for $ME:"; printf '%s\n' "$mail" | clean; exit 0; }
  done
  echo "no mail for $ME after ${max}s"; exit 2 ;;
whoami)
  [ $# -eq 0 ] || unknown "$1"
  printf 'name:    %s\nstore:   %s\nadapter: %s\nroot:    %s\nbranch:  %s\nconfig:  %s\nkey:     %s%s\nstate:   %s\n' \
    "${ME:-<unset>}" "${STORE:-<unset>}" "$ADAPTER" "$ROOT" "$BRANCH" "$CONFIG" "${KEY:-<none>}" \
    "$( [ -n "$KEY" ] && [ -f "$KEY" ] || echo ' (missing)')" "$STATE" ;;
doctor)
  [ $# -eq 0 ] || unknown "$1"
  ok=0
  chk() { if eval "$2" >/dev/null 2>&1; then echo "ok   $1"; else echo "FAIL $1${3:+: $3}"; ok=1; fi; }
  chk "shell parses this script" 'sh -n "$0"'
  chk "git is installed" "command -v git" "the git adapter needs it"
  chk "ssh-keygen -Y is available" have_ssh "needed only to sign and verify mail (OpenSSH 8.1+)"
  chk "a store is configured" '[ -n "$STORE" ]' "run setup --store"
  chk "an agent name is set" '[ -n "$ME" ]' "run setup --name, or pass --as"
  chk "the mailbox folder (root) is valid" root_ok "set it with setup --root: letters, digits, '.', '_' and '-'; no part '..' or '.git' in any case, or starting with '-'"
  chk "the branch name is valid" 'branch_ok "$BRANCH"' "set it with setup --branch${AGENT_MAILBOX_BRANCH:+ and unset AGENT_MAILBOX_BRANCH}: a name git accepts, of letters, digits, '.', '_', '-' and '/'"
  chk "the CLI finds its adapter" 'matches "^[a-z0-9-]+\$" "$ADAPTER" && lib_ok && [ -f "$LIB_DIR/$ADAPTER.sh" ]' "run it by its path or through install.sh's link, or set AGENT_MAILBOX_LIB"
  sok=""
  if [ -n "$STORE" ]; then
    # (another command working in this name's copy of the store is waited for a few seconds, then said to be busy)
    if derr=$( ( AGENT_MAILBOX_LOCK_WAIT=5; export AGENT_MAILBOX_LOCK_WAIT; load_adapter && ad_sync && need_store ) 2>&1 >/dev/null )
    then echo "ok   the store is reachable and initialized"; sok=1
      # what the sync said on the way (a lost init dropped, earlier commits published) is shown, not swallowed
      [ -z "$derr" ] || printf '%s\n' "$derr" | LC_ALL=C sed -n 's/^agent-mailbox: /warn /p'
    # (only the lock's own failure is busy: the last line, starting with the lock's words; earlier lines, and the
    # rest of a failure line, can quote the store or its host)
    else case $(printf '%s\n' "$derr" | tail -n 1) in
      ("agent-mailbox: another agent-mailbox command (pid "*) echo "busy the store wasn't checked: another agent-mailbox command is working in this name's copy of it; run doctor again once it's done" ;;
      (*) echo "FAIL the store is reachable and initialized: run agents to see why"; ok=1
          # (the agent-mailbox: lines before the last one, which is the failure; a failure can span lines)
          printf '%s\n' "$derr" | LC_ALL=C awk '{ l[NR] = $0; if (index($0, "agent-mailbox: ") == 1) last = NR }
            END { for (i = 1; i < last; i++) if (index(l[i], "agent-mailbox: ") == 1) print "warn " substr(l[i], 16) }' ;; esac
    fi
  fi
  # the name's line needs the store: after that line fails, a stale copy (or none) would give a wrong hint. A name whose
  # record isn't active (retired) comes back with update, not register, which would refuse it; but only its own agent
  # should, so the hint says so: by key when the record's key and this agent's can be compared, otherwise in words
  [ -z "$ME" ] || [ -z "$sok" ] || case $( load_adapter >/dev/null 2>&1 || exit
      if active "$ME"; then echo ok
      elif [ -f "$(record "$ME")" ]; then
        rk=$(field key "$(record "$ME")"); mk=""; [ -z "$rk" ] || [ ! -f "$KEY" ] || mk=$(own_pub)
        if [ -n "$rk" ] && [ -n "$mk" ]; then [ "$rk" = "$mk" ] && echo mine || echo other
        elif [ -n "$rk" ] && [ -f "$KEY" ]; then echo nopub; else echo retired; fi
      fi ) in
    (ok) echo "ok   $ME is registered and active" ;;
    (mine) echo "FAIL $ME is registered and active: it's retired here; run update --status active to come back"; ok=1 ;;
    (other) echo "FAIL $ME is registered and active: it's another agent's retired name here (its key isn't yours); pick another name"; ok=1 ;;
    (retired) echo "FAIL $ME is registered and active: it's retired here: if it's yours, run update --status active to come back; if not, pick another name"; ok=1 ;;
    (nopub) echo "FAIL $ME is registered and active: it's retired here: if it's yours, restore your key's public half ('ssh-keygen -y -f $KEY > $KEY.pub'), then run update --status active; if not, pick another name"; ok=1 ;;
    (*) echo "FAIL $ME is registered and active: run register"; ok=1 ;;
  esac
  # (with its fingerprint, read from this machine: the side an agent's human compares with what others see)
  [ -z "$KEY" ] || { [ -f "$KEY" ] && { kf=""; ! have_ssh || kf=$(fpnote "$(own_pub)")
      printf 'ok   signing key at %s%s\n' "$KEY" "${kf:+ ($kf)}"; } || printf 'warn no signing key at %s (mail will be unsigned)\n' "$KEY"; }
  exit $ok ;;
help|-h|--help) sed -n '2,/^set -u$/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
*) die "unknown command '$cmd' (try: agent-mailbox help)" ;;
esac
