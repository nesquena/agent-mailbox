#!/bin/sh
# agent-mailbox: a small, file-based mailbox for AI agents (and the humans who run them).
# Spec: PROTOCOL.md. Guide for a joining agent: JOIN.md. POSIX sh; needs git for the git adapter, and OpenSSH 8+
# (ssh-keygen -Y) only for signed mail.
#
# Usage: agent-mailbox [--as <name>] [--config <file>] <command> [args]
#
#   setup --store <url|path> [--adapter git|dir] [--root <dir>] [--branch <b>] [--name <me>]
#                                       write this machine's config (see "Configuration" in README.md)
#   init [--require-signatures] [--title <text>]
#                                       create the mailbox layout in an empty store (once per store)
#   register --kind <kind> --about <text> [--runs-on <text>] [--watch <text>] [--key <pub>|--no-key]
#                                       add yourself to the registry; generates a signing key unless --no-key
#   update [--kind ...] [--about ...] [--runs-on ...] [--watch ...] [--status active|retired]
#                                       change your own registry record
#   agents                              list registered agents
#   trust <name>                        accept <name>'s current key after it changed (re-pins it)
#   trust --relax                       stop treating this store as strict after its store.md stopped requiring
#                                       signatures (a store seen strict stays strict for you until then)
#   send <to> <topic> <body.md|-> [--context <c>] [--in-reply-to <file>] [--needs <text>] [--consume <file>]...
#        [--hold|--release "<item> <version>"]
#                                       deliver a message; --consume also removes mail you're answering
#   list                                your inbox, oldest first (exit 0: some, 3: none)
#   read [--except <file>]...           every message in full, with its signature status (exit 0 / 3)
#   consume <file>...                   remove messages you've acted on (the read receipt)
#   verify <file>                       check one message's signature; a bare file name is looked up in your
#                                       inbox (exit 0: verified, 6: not)
#   holds [<item>] [--version <v>]      each sender's latest hold or release in mail to you; with an item and
#                                       --version, exit 0 only if every sender's latest record releases it (else 5)
#   watch [interval=120] [max=7000] [--except <file>]...
#                                       wait for mail without spending model tokens; exits 0 with the mail listed,
#                                       2 after max seconds (0 = no limit). Run it in the background.
#   whoami | doctor                     show the resolved config | check this machine's setup
#
# Exit codes: 0 ok; 1 usage or store error; 2 watch timed out; 3 no mail; 4 written locally but not published
# (re-run any command to publish; don't resend); 5 not released; 6 signature not verified.
set -u
VERSION=0.1.0
PROTOCOL=1
NS=agent-mailbox
NAME_RE='^[a-z0-9][a-z0-9.-]{0,62}$'
ITEM_RE='^[A-Za-z0-9._/#:@-]{1,200} [A-Za-z0-9._-]{1,64}$'
# a message file name (PROTOCOL.md section 5); any other file in an inbox isn't a message, and is ignored
MSG_RE='^[A-Za-z0-9._-]+\.md$'
# a registry key: "<type> <base64>" and nothing else, so no allowed_signers option can reach ssh-keygen
KEY_RE='^(ssh-[a-z0-9-]+|ecdsa-[a-z0-9-]+|sk-[a-z0-9@.-]+) [A-Za-z0-9+/=]+$'

# printf, not echo, so a value quoted in a message is shown as is
die() { printf 'agent-mailbox: %s\n' "$*" >&2; exit 1; }
warn() { printf 'agent-mailbox: %s\n' "$*" >&2; }
# a global option after the command is refused with a hint wherever an option may appear (never an option's value)
misplaced() { case "$1" in (--as|--as=*|--config|--config=*) die "${1%%=*} goes before the command: agent-mailbox ${1%%=*} <value> $cmd ...";; esac; }
unknown() { misplaced "$1"; die "unknown option $1"; }
# matches <ERE> <value>: the whole value, on one line, matches. printf, not echo: dash's echo reads backslash escapes
# (a `\c` would cut the value short), and a line break or carriage return never passes
NL='
' CR=$(printf '\r')
matches() { case "$2" in (*"$NL"*|*"$CR"*) return 1 ;; esac; printf '%s\n' "$2" | grep -Eq -- "$1"; }
# this script's real folder, following links (install.sh links it onto PATH); plain readlink is on Linux, macOS, BSD
here() {
  p=$0
  # a $0 without a slash (bash searched PATH for the script) names no folder: fail rather than guess this one
  case "$p" in (*/*) ;; (*) [ -f "$p" ] || return 1 ;; esac
  while [ -L "$p" ]; do l=$(readlink "$p") || break; case "$l" in (/*) p=$l ;; (*) p=$(dirname "$p")/$l ;; esac; done
  CDPATH= cd -P -- "$(dirname "$p")" && pwd -P
}
SELF_DIR=$(here) || SELF_DIR=""
# the mailbox folder: a relative path whose parts can't be read as options or reach outside, or into git's own folder
root_ok() { matches '^[A-Za-z0-9._][A-Za-z0-9._-]*(/[A-Za-z0-9._][A-Za-z0-9._-]*)*$' "$ROOT" &&
  case "/$ROOT/" in (*/../*|*/.[Gg][Ii][Tt]/*) false ;; (*) true ;; esac; }
# a branch name git accepts, checked the same way with or without git (the dir adapter doesn't need it): within these
# characters, git refuses a part starting with '.' or ending in '.lock', '..', an empty part (a leading, trailing or
# doubled '/'), a final '.', a leading '-', and HEAD
branch_ok() { matches '^[A-Za-z0-9._/-]+$' "$1" &&
  case "/$1/" in (*/.*|*.lock/*|*..*|*//*|*./|/-*|/HEAD/) false ;; (*) true ;; esac; }
lib_ok() { [ -n "${AGENT_MAILBOX_LIB:-}" ] || [ -n "$SELF_DIR" ]; }
LIB_DIR="${AGENT_MAILBOX_LIB:-$SELF_DIR/../adapters}"

# --- configuration: flags > environment > config file > defaults ------------------------------------------------
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/agent-mailbox"
STATE="${AGENT_MAILBOX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-mailbox}"
CONFIG="${AGENT_MAILBOX_CONFIG:-$CONFIG_HOME/config}"
AS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --as) [ $# -ge 2 ] || die "--as needs a name"; AS=$2; shift 2 ;;
    --config) [ $# -ge 2 ] || die "--config needs a file"; CONFIG=$2; shift 2 ;;
    --version) echo "agent-mailbox $VERSION (protocol $PROTOCOL)"; exit 0 ;;
    *) break ;;
  esac
done
cfg() { [ -f "$CONFIG" ] && sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" "$CONFIG" | tail -n 1; }
STORE="${AGENT_MAILBOX_STORE:-$(cfg store)}"
ADAPTER="${AGENT_MAILBOX_ADAPTER:-$(cfg adapter)}"; ADAPTER="${ADAPTER:-git}"
ROOT="${AGENT_MAILBOX_ROOT:-$(cfg root)}"; ROOT="${ROOT:-mailbox}"
BRANCH="${AGENT_MAILBOX_BRANCH:-$(cfg branch)}"; BRANCH="${BRANCH:-main}"
# Where a session's name comes from: --as, then AGENT_MAILBOX_NAME, then the name this session's `watch` recorded
# (shells that keep no exports between commands), then the config file.
SESSION="${AGENT_MAILBOX_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}"
session_name() { [ -n "$SESSION" ] && tr -d ' \n' 2>/dev/null < "$STATE/sessions/$SESSION"; }
ME="${AS:-${AGENT_MAILBOX_NAME:-$(session_name || true)}}"; ME="${ME:-$(cfg name)}"
KEY="${AGENT_MAILBOX_KEY:-$(cfg key)}"; [ -n "$KEY" ] || [ -z "$ME" ] || KEY="$CONFIG_HOME/keys/$ME"

# --- helpers -------------------------------------------------------------------------------------------------------
one_line() { [ "$(printf '%s' "$2" | tr -d '\r\n')" = "$2" ] || die "$1 can't hold a line break"; }
valid_name() { one_line name "$1"; matches "$NAME_RE" "$1" || die "'$1' isn't a valid name (lowercase a-z, 0-9, '.', '-'; up to 63)"; }
need_me() { [ -n "$ME" ] || die "no agent name: run setup --name, set AGENT_MAILBOX_NAME, or pass --as"; valid_name "$ME"; }
stamp_iso() { echo "$1" | sed -E 's/^(....)(..)(..)T(..)(..)(..)Z$/\1-\2-\3T\4:\5:\6Z/'; }
# OpenSSH 8+ lists `ssh-keygen -Y sign` in its usage; older versions don't (ERE, so BSD grep reads it the same)
have_ssh() { command -v ssh-keygen >/dev/null 2>&1 && ssh-keygen -Y 2>&1 | grep -Eq 'ssh-keygen -Y (sign|verify)'; }
# header value of a field from a front-matter file (first occurrence, inside the --- block only)
# a header that never closes isn't a header (PROTOCOL.md section 5): every field reads empty
field() { awk -v k="$1" 'NR == 1 && $0 != "---" { exit } NR > 1 && $0 == "---" { closed = 1; exit }
  NR > 1 && !done { i = index($0, ":"); if (i && substr($0, 1, i - 1) == k) { v = substr($0, i + 1); sub(/^ /, "", v); done = 1 } }
  END { if (closed && done) print v }' "$2"; }
# write $2 to $1 atomically: a temp file in the same directory, then a rename
put() { tmp="$1.tmp.$$"; printf '%s\n' "$2" > "$tmp" && mv -f "$tmp" "$1" || { rm -f "$tmp"; die "can't write $1"; }; }
# set_cfg <key> <value>: replace or add one line of the config file
set_cfg() {
  one_line "$1" "$2"; mkdir -p "$(dirname "$CONFIG")" || die "can't create $(dirname "$CONFIG")"
  rest=$( [ -f "$CONFIG" ] && grep -v "^$1[[:space:]]*=" "$CONFIG" ); put "$CONFIG" "$(printf '%s\n%s = %s' "$rest" "$1" "$2" | sed '/^$/d')"
}
sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -c1-16; else shasum -a 256 | cut -c1-16; fi; }
# Text from the store is shown with the characters that move the cursor or reorder a line spelled out, so it can't
# overwrite a line or disguise what it says: C0 controls but tab and line feed, DEL and NUL as \xNN; C1 controls,
# Unicode's bidi embeddings, overrides and isolates, its line/paragraph separators and its tag characters as <U+XXXX>. A carriage return
# just before a line feed (Windows line endings) is dropped. ESC is a sed script for LC_ALL=C (byte by byte, the same
# in GNU and BSD sed), built with printf's octal escapes.
esc_script() {
  c0="" n=1; while [ $n -le 31 ]; do [ $n = 9 ] || [ $n = 10 ] || c0="$c0 $n $n"; n=$((n+1)); done
  c1="" n=128; while [ $n -le 159 ]; do c1="$c1 $n $n"; n=$((n+1)); done
  # <second byte> <third byte> <code point> of each three-byte (E2 xx xx) character
  u=""; for b in 168 169 170 171 172 173 174; do u="$u 128 $b $((8064 + b))"; done
  for b in 166 167 168 169; do u="$u 129 $b $((8128 + b))"; done
  # <third byte> <fourth byte> <code point> of each tag character (U+E0000-E007F, F3 A0 xx xx), which can carry text
  # a reader never sees
  t=""; for c in 128 129; do b=128; while [ $b -le 191 ]; do t="$t $c $b $((917504 + (c - 128) * 64 + b - 128))"; b=$((b+1)); done; done
  # shellcheck disable=SC2086
  printf "$(printf 's/\\015$//\\n/[\\001-\\010\\013-\\037\\177\\302\\342\\363\\377]/{\\n'
    printf 's/\\%03o/\\\\\\\\x%02x/g\\n' $c0 127 127 255 0
    printf 's/\\302\\%03o/<U+%04X>/g\\n' $c1
    printf 's/\\342\\%03o\\%03o/<U+%04X>/g\\n' $u
    printf 's/\\363\\240\\%03o\\%03o/<U+%05X>/g\\n' $t; printf '}')"
}
ESC=$(esc_script)
# clean [<sed script>]: stdin to stdout, escaped as above, then the optional script. tr maps NUL (which sed can't
# name and a shell's $(...) drops) to 0xff, which ESC shows as \x00. ceiling: a raw 0xff byte (never in UTF-8 text)
# shows as \x00 too, and stray 0x80-0xff bytes that aren't UTF-8 pass as is; escaping them needs a UTF-8 decoder.
clean() { LC_ALL=C tr '\000' '\377' | LC_ALL=C sed -e "$ESC" ${1:+-e "$1"}; }
# CAP: a sed script for LC_ALL=C that cuts a line longer than 200 bytes to 200, without splitting a UTF-8
# character, and marks the cut with "..."
CAP=$(printf '/^.\\{201\\}/{\ns/^\\(.\\{200\\}\\).*/\\1/\ns/[\300-\337]$//\ns/[\340-\357][\200-\277]\\{0,1\\}$//\ns/[\360-\367][\200-\277]\\{0,2\\}$//\ns/$/.../\n}')

# --- the store, through its adapter (contract: adapters/README.md) --------------------------------------------------
load_adapter() {
  lib_ok || die "can't find the folder this script is in ($0); set AGENT_MAILBOX_LIB"
  root_ok || die "root must be a relative path of letters, digits, '.', '_' and '-' (no part '..' or '.git' in any case, or starting with '-'), not '$ROOT'"
  branch_ok "$BRANCH" || die "bad branch name '$BRANCH' (from ${AGENT_MAILBOX_BRANCH:+AGENT_MAILBOX_BRANCH, which overrides }the config)"
  [ -n "$STORE" ] || die "no store configured: run 'agent-mailbox setup --store <url|path>' (or set AGENT_MAILBOX_STORE)"
  matches '^[a-z0-9-]+$' "$ADAPTER" || die "bad adapter name '$ADAPTER'"
  [ -f "$LIB_DIR/$ADAPTER.sh" ] || die "no adapter '$ADAPTER' (looked in $LIB_DIR)"
  STORE_ID=$(printf '%s' "$STORE|$ROOT|$BRANCH" | sha)
  # shellcheck source=/dev/null
  . "$LIB_DIR/$ADAPTER.sh"
  ad_open
  M="$AD_DIR/$ROOT"
}
need_store() {
  [ -f "$M/store.md" ] || die "the store has no mailbox at '$ROOT/' yet: run 'agent-mailbox init' once"
  v=$(field protocol "$M/store.md"); case "$v" in ''|*[!0-9]*) die "store.md has no valid protocol version" ;; esac
  [ "$v" -le "$PROTOCOL" ] || die "this mailbox uses protocol $v; this client speaks $PROTOCOL (upgrade agent-mailbox)"
}
# a store seen requiring signatures stays strict for this reader (pinned like a key), so an edit to store.md can't
# turn signatures off; `trust --relax` lifts the pin after checking with the store's owner
require_sigs() {
  pin="$STATE/pins/$STORE_ID/.strict"
  if [ "$(field require_signatures "$M/store.md")" = true ]; then
    [ -f "$pin" ] || { mkdir -p "$STATE/pins/$STORE_ID" && : > "$pin"; }; return 0; fi
  [ -f "$pin" ] || return 1
  warn "store.md no longer requires signatures; still treating this store as strict (after checking with its owner: trust --relax)"
}
record() { printf '%s\n' "$M/agents/$1.md"; }
# reg_key <record file>: the key the record names, or nothing when it names none or the value isn't a plain key
reg_key() { rk=$(field key "$1" 2>/dev/null); matches "$KEY_RE" "$rk" && printf '%s\n' "$rk"; }
active() { [ -f "$(record "$1")" ] && [ "$(field status "$(record "$1")")" = active ]; }
# you must be active to send or watch; a retired agent is told how to come back
need_active_me() { active "$ME" && return 0; [ -f "$(record "$ME")" ] && die "'$ME' (you) is retired in this mailbox: run 'update --status active' to come back"
  die "'$ME' (you) isn't registered in this mailbox: register first (JOIN.md)"; }
inbox_files() { [ -d "$M/inbox/$1" ] || return 0
  find "$M/inbox/$1" -maxdepth 1 -type f -name '*.md' | sort | while IFS= read -r p; do
    basename "$p" | grep -Eq "$MSG_RE" && printf '%s\n' "$p"; done; }
# no_link <path>: refuse to write at or under <path> when any part of it below the store's own folder is a symlink,
# so a link a writer plants in a shared store can't redirect writes outside it
no_link() {
  sub=${1#"$AD_DIR"/}; cur=$AD_DIR
  for part in $(echo "$sub" | tr '/' ' '); do
    cur="$cur/$part"; [ -L "$cur" ] && die "refusing to write through a symlink in the store: $(rel "$cur")"
  done; return 0
}
valid_msg() { matches "$MSG_RE" "$1" || die "'$1' isn't a message file name"; }
rel() { printf '%s\n' "${1#"$AD_DIR"/}"; }

# --- signatures ----------------------------------------------------------------------------------------------------
# verify_file <message path> [<expected from>] prints one word: verified | unsigned | bad | nokey | changed | misrouted
verify_file() {
  f=$1 inb=${2:-}
  from=$(field from "$f"); to=$(field to "$f")
  matches "$NAME_RE" "$from" && matches "$NAME_RE" "$to" || { echo bad; return; }
  [ -z "$inb" ] || [ "$to" = "$inb" ] || { echo misrouted; return; }
  [ -f "$f.sig" ] || { echo unsigned; return; }
  rec=$(record "$from"); [ -f "$rec" ] || { echo nokey; return; }
  pub=$(reg_key "$rec"); [ -n "$pub" ] || { echo nokey; return; }
  have_ssh || { echo nokey; return; }
  # trust on first use: pin the key's fingerprint per store; a different key later is "changed" until `trust`
  pins="$STATE/pins/$STORE_ID"; mkdir -p "$pins"
  fp=$(printf '%s\n' "$pub" | sha)
  if [ -f "$pins/$from" ]; then [ "$(cat "$pins/$from")" = "$fp" ] || { echo changed; return; }
  else echo "$fp" > "$pins/$from"; fi
  allowed="$STATE/tmp.allowed.$$"; mkdir -p "$STATE"
  printf '%s %s\n' "$from" "$pub" > "$allowed"
  if ssh-keygen -Y verify -f "$allowed" -I "$from" -n "$NS" -s "$f.sig" < "$f" >/dev/null 2>&1; then r=verified; else r=bad; fi
  rm -f "$allowed"; echo "$r"
}
sign_file() { ssh-keygen -Y sign -q -n "$NS" -f "$KEY" "$1" >/dev/null 2>&1 || die "signing failed with $KEY"; }
can_sign() { [ -f "$KEY" ] && have_ssh; }

# --- commands ------------------------------------------------------------------------------------------------------
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
setup)
  store="$STORE" adapter="$ADAPTER" root="$ROOT" branch="$BRANCH" name="${AS:-$(cfg name)}"
  while [ $# -gt 0 ]; do
    misplaced "$1"; [ $# -ge 2 ] || die "$1 needs a value"
    case "$1" in --store) store=$2 ;; --adapter) adapter=$2 ;; --root) root=$2 ;; --branch) branch=$2 ;;
                 --name) name=$2 ;; *) unknown "$1" ;; esac; shift 2
  done
  [ -n "$store" ] || die "usage: setup --store <url|path> [--adapter git|dir] [--root <dir>] [--branch <b>] [--name <me>]"
  [ -z "$name" ] || valid_name "$name"
  for v in store:"$store" root:"$root" branch:"$branch"; do one_line "${v%%:*}" "${v#*:}"; done
  [ -z "$branch" ] || branch_ok "$branch" || die "bad branch name '$branch': pass --branch <name>"
  mkdir -p "$(dirname "$CONFIG")" || die "can't create $(dirname "$CONFIG")"
  put "$CONFIG" "$(printf '# agent-mailbox config (one key = value per line)\nstore = %s\nadapter = %s\nroot = %s\nbranch = %s\n%s' \
    "$store" "$adapter" "$root" "$branch" "${name:+name = $name
}")"
  printf 'wrote %s\n' "$CONFIG" ;;
init)
  req=false title="agent mailbox"
  while [ $# -gt 0 ]; do
    case "$1" in --require-signatures) req=true; shift ;; --title) [ $# -ge 2 ] || die "--title needs text"; title=$2; shift 2 ;;
                 *) unknown "$1" ;; esac
  done
  one_line title "$title"
  load_adapter; ad_sync
  [ -f "$M/store.md" ] && die "a mailbox already exists at '$ROOT/' in this store"
  no_link "$M/agents/.keep"; no_link "$M/inbox/.keep"; no_link "$M/store.md"
  mkdir -p "$M/agents" "$M/inbox"; : > "$M/agents/.keep"; : > "$M/inbox/.keep"
  put "$M/store.md" "$(printf -- '---\nprotocol: %s\ntitle: %s\nrequire_signatures: %s\ncreated: %s\n---\n\nThis folder is an agent mailbox. Spec: https://github.com/nesquena/agent-mailbox/blob/main/PROTOCOL.md\n' \
    "$PROTOCOL" "$title" "$req" "$(date -u +%Y-%m-%dT%H:%M:%SZ)")"
  ad_commit "mailbox: init" "$ROOT/store.md" "$ROOT/agents/.keep" "$ROOT/inbox/.keep"
  echo "initialized a mailbox at '$ROOT/' (require_signatures: $req)" ;;
register|update)
  need_me; load_adapter; ad_sync; need_store
  rec=$(record "$ME"); kind="" about="" runs="" watchv="" status="" keyfile="" nokey=""
  while [ $# -gt 0 ]; do
    case "$1" in --no-key) nokey=1; shift; continue ;; esac
    misplaced "$1"; [ $# -ge 2 ] || die "$1 needs a value"
    case "$1" in --kind) kind=$2 ;; --about) about=$2 ;; --runs-on) runs=$2 ;; --watch) watchv=$2 ;;
                 --status) status=$2 ;; --key) keyfile=$2 ;; *) unknown "$1" ;; esac; shift 2
  done
  if [ "$cmd" = register ]; then
    [ -f "$rec" ] && die "'$ME' is already registered (names are unique; use 'update' to change your record)"
    [ -n "$kind" ] && [ -n "$about" ] || die "usage: register --kind <kind> --about <text> [--runs-on <text>] [--watch <text>] [--key <pub>|--no-key]"
    status=active
  else
    [ -f "$rec" ] || die "'$ME' isn't registered yet (use 'register')"
    kind="${kind:-$(field kind "$rec")}"; about="${about:-$(field about "$rec")}"; runs="${runs:-$(field runs_on "$rec")}"
    watchv="${watchv:-$(field watch "$rec")}"; status="${status:-$(field status "$rec")}"
  fi
  case "$status" in active|retired) ;; *) die "status is active or retired" ;; esac
  for v in kind:"$kind" about:"$about" runs_on:"$runs" watch:"$watchv"; do one_line "${v%%:*}" "${v#*:}"; done
  pub="" own=""
  if [ "$cmd" = update ]; then
    # an agent holding its key never re-signs a record whose key someone else changed; without it (a machine that
    # lost its key) the record is republished as it is, and nothing is pinned below
    pub=$(field key "$rec")
    if [ -f "$KEY" ]; then
      own=$(cut -d' ' -f1,2 "$KEY.pub" 2>/dev/null); matches "$KEY_RE" "$own" || own=$(ssh-keygen -y -P '' -f "$KEY" 2>/dev/null | cut -d' ' -f1,2)
      [ -n "$own" ] || [ -z "$pub" ] || die "can't read the public half of $KEY: restore it with 'ssh-keygen -y -f $KEY > $KEY.pub', then run update again"
    fi
    if [ -n "$own" ] && [ -n "$pub" ] && [ "$pub" != "$own" ]; then
      die "your registry record's key isn't yours ($KEY.pub), so update won't republish it: if someone else changed it, check with your human, then remove $ROOT/agents/$ME.md and its .sig from the store and run register again"
    fi
  fi
  if [ "$cmd" = register ] && [ -z "$nokey" ]; then
    if [ -n "$keyfile" ]; then
      [ -f "$keyfile" ] || die "no such key file $keyfile"
      pub=$(cut -d' ' -f1,2 "$keyfile"); KEY="${keyfile%.pub}"
      [ -f "$KEY" ] || die "the private key ${KEY} (beside $keyfile) is missing"
      set_cfg key "$(CDPATH= cd -P -- "$(dirname "$KEY")" && pwd -P)/$(basename "$KEY")"
    elif have_ssh; then
      if [ ! -f "$KEY" ]; then
        mkdir -p "$(dirname "$KEY")" && chmod 700 "$(dirname "$KEY")"
        ssh-keygen -q -t ed25519 -N '' -C "$NS:$ME" -f "$KEY" || die "ssh-keygen failed"
        printf 'generated a signing key at %s (keep the private half on this machine only)\n' "$KEY"
      fi
      pub=$(cut -d' ' -f1,2 "$KEY.pub")
    else
      require_sigs && die "this store requires signatures, and ssh-keygen (OpenSSH 8+) isn't available here"
      warn "ssh-keygen not found: registering without a signing key (mail from you will be unsigned)"
    fi
  fi
  [ -z "$pub" ] || matches "$KEY_RE" "$pub" || die "that doesn't look like an SSH public key"
  if require_sigs && [ -z "$pub" ]; then die "this store requires signatures: register with a key"; fi
  when=$(field registered "$rec" 2>/dev/null); [ -n "$when" ] || when=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  no_link "$rec"; no_link "$M/inbox/$ME/.keep"
  mkdir -p "$M/agents"
  put "$rec" "$(printf -- '---\nname: %s\nkind: %s\nabout: %s\nruns_on: %s\nwatch: %s\nstatus: %s\nkey: %s\nregistered: %s\n---\n' \
    "$ME" "$kind" "$about" "$runs" "$watchv" "$status" "$pub" "$when")"
  paths="$ROOT/agents/$ME.md"
  if [ -n "$pub" ] && can_sign; then rm -f "$rec.sig"; sign_file "$rec"; paths="$paths $ROOT/agents/$ME.md.sig"; fi
  mkdir -p "$M/inbox/$ME"; [ -f "$M/inbox/$ME/.keep" ] || { : > "$M/inbox/$ME/.keep"; paths="$paths $ROOT/inbox/$ME/.keep"; }
  # shellcheck disable=SC2086
  ad_commit "mailbox: $ME ${cmd}s" $paths
  # a retired agent has no watcher to keep armed: drop this session's marker, so a harness hook stops asking for one
  if [ "$status" = retired ] && [ -n "$SESSION" ] && [ "$(session_name)" = "$ME" ]; then rm -f "$STATE/sessions/$SESSION"; fi
  # pin your own name only to a key you hold
  [ -z "$pub" ] || { [ "$cmd" = update ] && [ -z "$own" ]; } || { mkdir -p "$STATE/pins/$STORE_ID"; printf '%s\n' "$pub" | sha > "$STATE/pins/$STORE_ID/$ME"; }
  echo "$cmd: $ME ($status)${pub:+, signing key $(printf '%s' "$pub" | cut -c1-24)...}" ;;
agents)
  [ $# -eq 0 ] || unknown "$1"
  load_adapter; ad_sync; need_store
  printf '%-24s %-8s %-10s %-4s %s\n' NAME STATUS KIND KEY ABOUT
  for r in "$M"/agents/*.md; do
    [ -f "$r" ] || continue
    k=no; [ -n "$(reg_key "$r")" ] && k=yes
    n=$(basename "$r" .md); matches "$NAME_RE" "$n" || continue
    [ "$(field name "$r")" = "$n" ] || n="$n(!name)"
    # the record's status, kind and about are escaped and cut to 200 bytes each, so no record can draw rows
    printf '%s\n%s\n%s\n' "$(field status "$r")" "$(field kind "$r")" "$(field about "$r")" | clean "$CAP" |
      { IFS= read -r s; IFS= read -r kd; IFS= read -r ab; printf '%-24s %-8s %-10s %-4s %s\n' "$n" "$s" "$kd" "$k" "$ab"; }
  done ;;
trust)
  for a in "$@"; do misplaced "$a"; done; [ $# -eq 1 ] || die "usage: trust <name> | trust --relax"
  if [ "$1" = --relax ]; then load_adapter; rm -f "$STATE/pins/$STORE_ID/.strict"
    echo "this store is strict for you only while its store.md requires signatures"; exit 0; fi
  valid_name "$1"; load_adapter; ad_sync
  pub=$(reg_key "$(record "$1")"); [ -n "$pub" ] || die "'$1' has no registered key"
  mkdir -p "$STATE/pins/$STORE_ID"; printf '%s\n' "$pub" | sha > "$STATE/pins/$STORE_ID/$1"
  echo "pinned $1's current key; mail $1 signed with an earlier key (holds included) no longer counts" ;;
send)
  [ $# -ge 3 ] || die "usage: send <to> <topic> <body.md|-> [--context c] [--in-reply-to file] [--needs text] [--consume file]... [--hold|--release \"<item> <version>\"]"
  to=$1 topic=$2 body=$3; shift 3
  context="" ctx_set="" reply="" needs=none consume="" hold="" release=""
  while [ $# -gt 0 ]; do
    misplaced "$1"; [ $# -ge 2 ] || die "$1 needs a value"
    case "$1" in
      --context) context=$2; ctx_set=1 ;; --in-reply-to) reply=$(basename -- "$2") ;; --needs) needs=$2 ;;
      --consume) consume="$consume $(basename -- "$2")" ;; --hold) hold=$2 ;; --release) release=$2 ;;
      *) unknown "$1" ;;
    esac; shift 2
  done
  need_me; valid_name "$to"
  [ -n "$reply" ] || reply=$(echo $consume | cut -d' ' -f1); [ -n "$reply" ] || reply=none
  [ -n "$hold" ] && [ -n "$release" ] && die "a message records a hold or a release, not both"
  for h in "$hold" "$release"; do [ -z "$h" ] || matches "$ITEM_RE" "$h" || die "a hold or release is \"<item> <version>\", not '$h'"; done
  for v in context:"$context" topic:"$topic" in_reply_to:"$reply" needs:"$needs" hold:"$hold" release:"$release"; do one_line "${v%%:*}" "${v#*:}"; done
  matches "$NAME_RE" "$topic" || die "topic must be lowercase a-z, 0-9, '.' or '-'"
  [ -z "$ctx_set" ] || matches "$NAME_RE" "$context" || die "context must be lowercase a-z, 0-9, '.' or '-'"
  [ "$body" = - ] && body=/dev/stdin
  [ "$body" = /dev/stdin ] || [ -f "$body" ] || die "the body must be a file path, or - for stdin"
  text=$(cat -- "$body") || die "can't read $body"; [ -n "$text" ] || die "empty message body"
  load_adapter; ad_sync; need_store
  active "$to" || die "'$to' isn't an active agent in this mailbox"
  need_active_me
  if require_sigs; then can_sign || die "this store requires signatures, and no usable key is at $KEY"; fi
  for c in $consume; do valid_msg "$c"; [ -f "$M/inbox/$ME/$c" ] || die "not in your inbox: $c"; done
  # a reply keeps the thread's context (PROTOCOL.md section 5), read from the message it answers while that's still
  # in your inbox; otherwise, and for a value that isn't a valid context, it's "general"
  if [ -z "$ctx_set" ] && matches "$MSG_RE" "$reply" && [ -f "$M/inbox/$ME/$reply" ] && [ ! -L "$M/inbox/$ME/$reply" ]; then
    context=$(field context "$M/inbox/$ME/$reply"); matches "$NAME_RE" "$context" || context=""
  fi
  context="${context:-general}"
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  # holds orders one sender's records by their sent time, to the second, and on a tie a hold beats a release: a hold
  # or release waits for the next second after this sender's previous one in this store, so the two never tie.
  # ceiling: it knows only this machine's sends (a name has one live session) and an equal second, not a clock set
  # back; reading the sender's latest record from the store's history would cover both
  if [ -n "$hold$release" ]; then
    last="$STATE/gates/$STORE_ID/$ME"
    while [ "$(cat "$last" 2>/dev/null)" = "$stamp" ]; do sleep 1; stamp=$(date -u +%Y%m%dT%H%M%SZ); done
    mkdir -p "$STATE/gates/$STORE_ID" && printf '%s\n' "$stamp" > "$last" || die "can't write $last"
  fi
  f="$M/inbox/$to/$stamp-$ME-$topic.md"
  { [ -e "$f" ] || [ -L "$f" ]; } && die "$(rel "$f") exists (one message per topic per second)"
  no_link "$f"; [ -d "$M/inbox/$to" ] || [ ! -e "$M/inbox/$to" ] || die "$(rel "$M/inbox/$to") isn't a folder"
  mkdir -p "$M/inbox/$to"; paths=""
  [ -f "$M/inbox/$to/.keep" ] || { : > "$M/inbox/$to/.keep"; paths="$ROOT/inbox/$to/.keep"; }
  put "$f" "$(printf -- '---\nprotocol: %s\nfrom: %s\nto: %s\ntopic: %s\ncontext: %s\nsent: %s\nin_reply_to: %s\nneeds: %s\n%s%s---\n\n%s\n' \
    "$PROTOCOL" "$ME" "$to" "$topic" "$context" "$(stamp_iso "$stamp")" "$reply" "$needs" \
    "${hold:+hold: $hold
}" "${release:+release: $release
}" "$text")"
  paths="$paths $(rel "$f")"
  if can_sign && [ -n "$(reg_key "$(record "$ME")")" ]; then sign_file "$f"; paths="$paths $(rel "$f").sig"
  else warn "sending unsigned (no key at $KEY, or ssh-keygen missing)"; fi
  for c in $consume; do rm -f "$M/inbox/$ME/$c" "$M/inbox/$ME/$c.sig"; paths="$paths $ROOT/inbox/$ME/$c $ROOT/inbox/$ME/$c.sig"; done
  # shellcheck disable=SC2086
  ad_commit "mail(to-$to): $topic" $paths
  echo "sent $(rel "$f")" ;;
list)
  [ $# -eq 0 ] || unknown "$1"
  need_me; load_adapter; ad_sync; need_store
  mail=$(inbox_files "$ME"); [ -n "$mail" ] || { echo "no mail for $ME"; exit 3; }
  printf '%s\n' "$mail" | while IFS= read -r p; do rel "$p"; done | clean ;;
read)
  except=""
  while [ $# -gt 0 ]; do
    case "$1" in --except) [ $# -ge 2 ] || die "--except needs a file"; except="$except $(basename -- "$2")"; shift 2 ;;
                 *) unknown "$1" ;; esac
  done
  need_me; load_adapter; ad_sync; need_store
  shown=$(inbox_files "$ME" | while IFS= read -r p; do
    case " $except " in (*" $(basename "$p") "*) continue ;; esac
    v=$(verify_file "$p" "$ME")
    printf '===== %s [%s]\n' "$(rel "$p")" "$v"
    # a body line can't pass for a boundary: a line whose first = comes after nothing but non-ASCII bytes (so no
    # visible ASCII text, and no invisible character can hide what comes first) is indented; a last line without its newline gets one, and each
    # message ends with its own marker
    clean 's/^[^ -~]*=/ &/' < "$p"; [ -z "$(tail -c 1 < "$p" | tr '\000' x)" ] || echo; printf '===== end %s\n\n' "$(rel "$p")"
  done)
  [ -n "$shown" ] || { echo "no mail for $ME"; exit 3; }
  printf '%s\n' "$shown" ;;
consume)
  [ $# -ge 1 ] || die "usage: consume <file>..."
  for a in "$@"; do case "$a" in (-*) unknown "$a" ;; esac; done
  need_me; load_adapter; ad_sync; need_store
  paths=""
  for a in "$@"; do
    b=$(basename "$a"); [ "$b" = .keep ] && die "an inbox's .keep is never consumed"
    valid_msg "$b"; [ -f "$M/inbox/$ME/$b" ] || die "not in your inbox: $b"; paths="$paths $ROOT/inbox/$ME/$b $ROOT/inbox/$ME/$b.sig"
  done
  for a in "$@"; do b=$(basename "$a"); rm -f "$M/inbox/$ME/$b" "$M/inbox/$ME/$b.sig"; done
  # shellcheck disable=SC2086
  ad_commit "mail(to-$ME): consumed $(for a in "$@"; do basename "$a" .md; done | tr '\n' ' ')" $paths
  echo "consumed" ;;
verify)
  for a in "$@"; do misplaced "$a"; done; [ $# -eq 1 ] || die "usage: verify <file>"; load_adapter; ad_sync
  # by path, by path in the store, or by message file name in your own inbox (a name only, never a pattern)
  # (by name it's checked as mail to you, so a copy addressed to someone else reads misrouted, as in read)
  f=$1 inb=""; [ -f "$f" ] || f="$AD_DIR/$1"
  if [ ! -f "$f" ]; then b=$(basename -- "$1"); f=""; matches "$MSG_RE" "$b" && { need_me; f="$M/inbox/$ME/$b" inb=$ME; }; fi
  [ -n "$f" ] && [ -f "$f" ] || die "no such message $1"
  v=$(verify_file "$f" "$inb"); echo "$v"; [ "$v" = verified ] || exit 6 ;;
holds)
  item="" version=""
  while [ $# -gt 0 ]; do
    case "$1" in --version) [ $# -ge 2 ] || die "--version needs a value"; version=$2; shift 2 ;;
                 -*) unknown "$1" ;; *) item=$1; shift ;; esac
  done
  need_me; [ -z "$version" ] || [ -n "$item" ] || die "--version needs an item"
  load_adapter; ad_sync; need_store
  strict=""; require_sigs && strict=1
  tmpd="$STATE/tmp.holds.$$"; mkdir -p "$tmpd" || die "can't create $tmpd"
  # every message ever delivered to you that may carry a hold or release, in delivery order (consumed mail
  # included): <ref> <path>. The pattern lets an adapter skip the rest; each record is still checked below. Files in
  # a subfolder of the inbox aren't messages (PROTOCOL.md section 2), as for read and list.
  records=$(ad_history "$ROOT/inbox/$ME" '^(hold|release):' | while IFS= read -r p; do ref=${p%% *} p=${p#* }
      [ "$ref" != '!' ] || { echo '!'; continue; }
      case "$p" in (*.md) ;; (*) continue ;; esac
      case "${p#"$ROOT/inbox/$ME/"}" in (*/*) continue ;; esac
      # a listed version it can't read stops holds, like a history it can't read
      ad_show "$ref" "$p" > "$tmpd/m" 2>/dev/null || { echo '!'; continue; }
      ad_show "$ref" "$p.sig" > "$tmpd/m.sig" 2>/dev/null || rm -f "$tmpd/m.sig"
      kind=hold; rec=$(field hold "$tmpd/m"); [ -n "$rec" ] || { kind=release; rec=$(field release "$tmpd/m"); }
      [ -n "$rec" ] || continue
      # every column of the row below is validated, so no header value can shift the others
      matches "$ITEM_RE" "$rec" && field from "$tmpd/m" | grep -Eq "$NAME_RE" &&
        field sent "$tmpd/m" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' &&
        basename "$p" | grep -Eq '^[A-Za-z0-9._-]+\.md$' || continue
      v=$(verify_file "$tmpd/m" "$ME")
      # in a strict store, only verified records count, except that a hold whose sender's key changed, or vanished
      # after this reader pinned it, still holds: dropping it would let a registry edit open the gate. unsigned and bad
      # never count, and nokey counts only for a pinned sender, so no hold planted under a name this reader never
      # verified counts. It clears when the key is restored, or trusted after checking with the sender's human
      [ -z "$strict" ] || [ "$v" = verified ] || { [ "$kind" = hold ] && { [ "$v" = changed ] ||
        { [ "$v" = nokey ] && [ -f "$STATE/pins/$STORE_ID/$(field from "$tmpd/m")" ]; }; }; } || continue
      echo "$(field sent "$tmpd/m") $kind $rec $(field from "$tmpd/m") $(basename "$p") $v"
    done)
  rm -rf "$tmpd"
  case "$NL$records$NL" in (*"$NL!$NL"*) die "can't read this store's full, latest history (check that the store is reachable), so holds can't decide" ;; esac
  [ -z "$item" ] || records=$(echo "$records" | awk -v i="$item" '$3 == i')
  # the latest record per item and sender, in delivery order; a record whose (signed) sent time is older than one
  # already seen from that sender for that item is a replay and is ignored. A store writer controls history order, so
  # order mustn't decide between records with an equal sent time: a hold wins, and two releases naming different
  # versions conflict (neither counts)
  latest=$(echo "$records" | awk 'NF { k = $3 " " $5
      if (!(k in t) || $1 > t[k]) { t[k] = $1; kind[k] = $2; v[k] = $4; last[k] = $0; next }
      if ($1 < t[k] || kind[k] == "hold") next
      if ($2 == "hold") { kind[k] = "hold"; v[k] = $4; last[k] = $0; next }
      if (kind[k] == "release" && $4 != v[k]) { kind[k] = "conflict"; last[k] = $1 " conflict " $3 " " v[k] "," $4 " " $5 " " $6 " " $7 } }
    END { for (k in last) print last[k] }' | sort -k3,3 -k1,1)
  if [ -z "$version" ]; then
    [ -n "$latest" ] && echo "$latest" || echo "no holds or releases recorded in mail to $ME${item:+ for $item}"
    exit 0
  fi
  [ -n "$latest" ] || { echo "holds: nothing recorded for $item"; exit 5; }
  echo "$latest" | awk -v want="$version" '
    $2 == "hold" && ($7 == "changed" || $7 == "nokey") { print "holds: " $3 " is held by " $5 " at " $4 " (" $6 ", " $7 ": confirm " $5 "'"'"'s new key (or restored record) with its human out of band and ask " $5 " to re-send any hold it still means, then trust " $5 " (mail signed with its old key, holds included, then stops counting), or restore its record)"; bad = 1; next }
    $2 == "hold" { print "holds: " $3 " is held by " $5 " at " $4 " (" $6 ")"; bad = 1; next }
    $2 == "conflict" { print "holds: " $3 " has releases from " $5 " sent at the same time for different versions (" $4 "); ask " $5 " to send one release again"; bad = 1; next }
    $4 != want { print "holds: " $3 " was released by " $5 " at " $4 ", not " want " (" $6 ")"; bad = 1; next }
    { print "holds: " $3 " released by " $5 " at " $4 " (" $6 ", " $7 ")"; if ($7 != "verified") weak = 1 }
    END { if (!bad && weak) print "holds: warning: a deciding release isn'"'"'t signature-verified; only a store with require_signatures: true makes holds tamper-proof" > "/dev/stderr"
          exit bad ? 5 : 0 }' ;;
watch)
  interval=120 max=7000 except="" pos=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --except) [ $# -ge 2 ] || die "--except needs a file"; except="$except $(basename -- "$2")"; shift 2 ;;
      -*) unknown "$1" ;;
      *) pos=$((pos+1)); [ $pos -eq 1 ] && interval=$1; [ $pos -eq 2 ] && max=$1; shift ;;
    esac
  done
  need_me
  case "$interval" in ''|*[!0-9]*) die "the interval must be whole seconds" ;; esac
  case "$max" in ''|*[!0-9]*) die "max must be whole seconds (0 for no limit)" ;; esac
  [ "$interval" -ge 1 ] && [ ${#interval} -le 6 ] && [ ${#max} -le 9 ] || die "the interval or max is out of range"
  load_adapter; ad_sync; need_store
  need_active_me
  # the session marker lets `send` find your name in shells without exports; the pid file lets a harness hook check
  # that this watcher is alive (hooks/claude-watch-guard.sh)
  mkdir -p "$STATE/run" "$STATE/sessions"
  [ -z "$SESSION" ] || echo "$ME" > "$STATE/sessions/$SESSION"
  echo "$$ $ME $STORE_ID" > "$STATE/run/$ME.pid"
  trap 'rm -f "$STATE/run/$ME.pid"' EXIT
  trap 'exit 130' INT TERM
  check() { ad_peek "$ROOT/inbox/$ME" | while IFS= read -r p; do
              b=$(basename "$p"); matches "$MSG_RE" "$b" || continue
              case " $except " in (*" $b "*) ;; (*) echo "$p" ;; esac; done; }
  last=$(ad_poll 2>/dev/null) || last=""
  mail=$(check) && [ -n "$mail" ] && { echo "mail for $ME:"; printf '%s\n' "$mail" | clean; exit 0; }
  # a store it can't reach ends the watch loudly after 10 failures in a row, so the agent wakes and sees why
  start=$(date +%s); fails=0
  while [ "$max" -eq 0 ] || [ $(( $(date +%s) - start )) -lt "$max" ]; do
    sleep "$interval"
    if now=$(ad_poll 2>/dev/null) && [ -n "$now" ]; then fails=0; else
      fails=$((fails+1)); [ "$fails" -lt 10 ] && continue; die "watch: can't reach the store ($fails tries in a row)"
    fi
    [ "$now" != "$last" ] || continue
    if ! mail=$(check); then fails=$((fails+1)); [ "$fails" -lt 10 ] && continue; die "watch: can't read the store"; fi
    last=$now
    [ -n "$mail" ] && { echo "mail for $ME:"; printf '%s\n' "$mail" | clean; exit 0; }
  done
  echo "no mail for $ME after ${max}s"; exit 2 ;;
whoami)
  [ $# -eq 0 ] || unknown "$1"
  printf 'name:    %s\nstore:   %s\nadapter: %s\nroot:    %s\nbranch:  %s\nconfig:  %s\nkey:     %s%s\nstate:   %s\n' \
    "${ME:-<unset>}" "${STORE:-<unset>}" "$ADAPTER" "$ROOT" "$BRANCH" "$CONFIG" "${KEY:-<none>}" \
    "$( [ -n "$KEY" ] && [ -f "$KEY" ] || echo ' (missing)')" "$STATE" ;;
doctor)
  [ $# -eq 0 ] || unknown "$1"
  ok=0
  chk() { if eval "$2" >/dev/null 2>&1; then echo "ok   $1"; else echo "FAIL $1${3:+: $3}"; ok=1; fi; }
  chk "shell parses this script" 'sh -n "$0"'
  chk "git is installed" "command -v git" "the git adapter needs it"
  chk "ssh-keygen -Y is available" have_ssh "needed only for signed mail (OpenSSH 8+)"
  chk "a store is configured" '[ -n "$STORE" ]' "run setup --store"
  chk "an agent name is set" '[ -n "$ME" ]' "run setup --name, or pass --as"
  chk "the mailbox folder (root) is valid" root_ok "set it with setup --root: letters, digits, '.', '_' and '-'; no part '..' or '.git' in any case, or starting with '-'"
  chk "the branch name is valid" 'branch_ok "$BRANCH"' "set it with setup --branch${AGENT_MAILBOX_BRANCH:+ and unset AGENT_MAILBOX_BRANCH}: a name git accepts, of letters, digits, '.', '_', '-' and '/'"
  chk "the CLI finds its adapter" 'matches "^[a-z0-9-]+\$" "$ADAPTER" && lib_ok && [ -f "$LIB_DIR/$ADAPTER.sh" ]' "run it by its path or through install.sh's link, or set AGENT_MAILBOX_LIB"
  if [ -n "$STORE" ]; then
    ( load_adapter && ad_sync && need_store ) >/dev/null 2>&1 && echo "ok   the store is reachable and initialized" ||
      { echo "FAIL the store is reachable and initialized"; ok=1; }
  fi
  [ -z "$ME" ] || [ -z "$STORE" ] || { ( load_adapter >/dev/null 2>&1 && active "$ME" ) && echo "ok   $ME is registered and active" ||
      { echo "FAIL $ME is registered and active: run register"; ok=1; }; }
  [ -z "$KEY" ] || { [ -f "$KEY" ] && printf 'ok   signing key at %s\n' "$KEY" || printf 'warn no signing key at %s (mail will be unsigned)\n' "$KEY"; }
  exit $ok ;;
help|-h|--help) sed -n '2,/^set -u$/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
*) die "unknown command '$cmd' (try: agent-mailbox help)" ;;
esac
